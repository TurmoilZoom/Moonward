<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog x:Class="Starward.Features.GameInstall.RepairGameDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:lang="using:Starward.Language"
               xmlns:local="using:Starward.Features.GameInstall"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               xmlns:sc="using:Starward.Controls"
               x:DefaultBindMode="OneWay"
               Background="{ThemeResource CustomAcrylicBrush}"
               BorderThickness="0"
               Style="{ThemeResource DefaultContentDialogStyle}"
               mc:Ignorable="d">


    <!--  与官方启动器的「请选择修复对象」一致：每个修复对象一行，各自一个修复按钮；卡片样式同游戏设置的版本信息  -->
    <StackPanel Width="420" Spacing="12">
        <TextBlock FontSize="20"
                   Text="{x:Bind lang:Lang.RepairGameDialog_Title}"
                   TextWrapping="Wrap" />
        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="{x:Bind lang:Lang.RepairGameDialog_Description}"
                   TextWrapping="Wrap" />

        <Border Margin="0,4,0,0"
                Padding="0,2,0,2"
                Background="{ThemeResource ControlFillColorDefaultBrush}"
                CornerRadius="8">
            <StackPanel>
                <!--  游戏资源  -->
                <Grid MinHeight="52"
                      Padding="16,0,12,0"
                      ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="24"
                          Height="24"
                          VerticalAlignment="Center"
                          CornerRadius="4">
                        <sc:CachedImage Width="24"
                                        Height="24"
                                        Source="{x:Bind CurrentGameBizIcon.GameIcon, FallbackValue={x:Null}}" />
                    </Grid>
                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               Text="{x:Bind lang:Lang.RepairGameDialog_GameResources}" />
                    <Button Grid.Column="2"
                            MinWidth="72"
                            VerticalAlignment="Center"
                            Command="{x:Bind RepairGameResourcesCommand}"
                            Content="{x:Bind lang:Lang.RepairGameDialog_Repair}" />
                </Grid>
                <!--  千星沙箱：只有带 WPF 包的游戏（目前是原神）才有  -->
                <StackPanel Visibility="{x:Bind HasWPFPackage}">
                    <Border Height="1"
                            Margin="16,0,16,0"
                            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Grid MinHeight="52"
                          Padding="16,0,12,0"
                          ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Width="24"
                                  Height="24"
                                  VerticalAlignment="Center"
                                  FontSize="18"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  Glyph="&#xEA86;" />
                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Text="{x:Bind lang:Lang.GameLauncherSettingDialog_MiliastraSandbox}" />
                        <Button Grid.Column="2"
                                MinWidth="72"
                                VerticalAlignment="Center"
                                Command="{x:Bind RepairWPFPackageCommand}"
                                Content="{x:Bind lang:Lang.RepairGameDialog_Repair}" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>

        <Button MinWidth="100"
                Margin="0,16,0,0"
                HorizontalAlignment="Right"
                Command="{x:Bind CancelCommand}"
                Content="{x:Bind lang:Lang.Common_Cancel}" />
    </StackPanel>

</ContentDialog>
