<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog x:Class="Starward.Features.GameInstall.RepairGameDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:lang="using:Starward.Language"
               xmlns:local="using:Starward.Features.GameInstall"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               xmlns:sc="using:Starward.Controls"
               x:DefaultBindMode="OneWay"
               Background="{ThemeResource CustomAcrylicBrush}"
               BorderThickness="0"
               Style="{ThemeResource DefaultContentDialogStyle}"
               mc:Ignorable="d">

    <ContentDialog.Resources>
        <Thickness x:Key="ContentDialogPadding">0</Thickness>
        <!--  模板里空的 Title 行仍带 0,0,0,12 的下边距，不清零的话顶部会比左右多空 12（同启动参数配置对话框）  -->
        <Thickness x:Key="ContentDialogTitleMargin">0</Thickness>
    </ContentDialog.Resources>


    <!--  与官方启动器的「请选择修复对象」一致：每个修复对象一行，各自一个修复按钮；卡片样式同游戏设置的版本信息  -->
    <StackPanel Width="468"
                Padding="24"
                Spacing="12">

        <!--  标题行（同启动参数配置对话框）：负边距把整行上移 16、右伸 16，关闭按钮贴到距边框 8 的右上角，标题仍与下方内容左缘对齐  -->
        <Grid Height="32"
              Margin="0,-16,-16,0"
              ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center"
                       FontSize="20"
                       Text="{x:Bind lang:Lang.RepairGameDialog_Title}"
                       TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="1"
                    Width="32"
                    Height="32"
                    Padding="0"
                    VerticalAlignment="Center"
                    BorderThickness="0"
                    Command="{x:Bind CloseCommand}"
                    CornerRadius="8"
                    Style="{ThemeResource DateTimePickerFlyoutButtonStyle}">
                <FontIcon FontSize="16"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          Glyph="&#xE711;"
                          IsTextScaleFactorEnabled="False" />
            </Button>
        </Grid>

        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="{x:Bind lang:Lang.RepairGameDialog_Description}"
                   TextWrapping="Wrap" />

        <Border Margin="0,4,0,0"
                Padding="0,2,0,2"
                Background="{ThemeResource ControlFillColorDefaultBrush}"
                CornerRadius="8">
            <StackPanel>
                <!--  游戏资源  -->
                <Grid MinHeight="52"
                      Padding="16,0,12,0"
                      ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="24"
                          Height="24"
                          VerticalAlignment="Center"
                          CornerRadius="4">
                        <sc:CachedImage Width="24"
                                        Height="24"
                                        Source="{x:Bind CurrentGameBizIcon.GameIcon, FallbackValue={x:Null}}" />
                    </Grid>
                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               Text="{x:Bind lang:Lang.RepairGameDialog_GameResources}" />
                    <Button Grid.Column="2"
                            MinWidth="72"
                            VerticalAlignment="Center"
                            Command="{x:Bind RepairGameResourcesCommand}"
                            Content="{x:Bind lang:Lang.RepairGameDialog_Repair}" />
                </Grid>
                <!--  千星沙箱：只有带 WPF 包的游戏（目前是原神）才有  -->
                <StackPanel Visibility="{x:Bind HasWPFPackage}">
                    <Border Height="1"
                            Margin="16,0,16,0"
                            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Grid MinHeight="52"
                          Padding="16,0,12,0"
                          ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!--  官方图标（getGames 的 wpf_icon），取不到时用拼图图标  -->
                        <Grid Width="24"
                              Height="24"
                              VerticalAlignment="Center">
                            <sc:CachedImage Width="24"
                                            Height="24"
                                            Source="{x:Bind WPFIconUrl}"
                                            Visibility="{x:Bind HasWPFIcon}" />
                            <FontIcon FontSize="18"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      Glyph="&#xEA86;"
                                      Visibility="{x:Bind HasNoWPFIcon}" />
                        </Grid>
                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Text="{x:Bind lang:Lang.GameLauncherSettingDialog_MiliastraSandbox}" />
                        <Button Grid.Column="2"
                                MinWidth="72"
                                VerticalAlignment="Center"
                                Command="{x:Bind RepairWPFPackageCommand}"
                                Content="{x:Bind lang:Lang.RepairGameDialog_Repair}" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>

</ContentDialog>
