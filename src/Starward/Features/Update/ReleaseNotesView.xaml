<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="Starward.Features.Update.ReleaseNotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lang="using:Starward.Language"
             xmlns:local="using:Starward.Features.Update"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sc="using:Starward.Controls"
             mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  版本条：放在滚动区外，始终停在顶部；点击跳到该版本，滚动时高亮当前看到的版本。只有一个版本时隐藏  -->
        <Grid x:Name="Grid_VersionBar"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,0,0,1"
              Visibility="Collapsed">
            <!--  版本多时横向滚动  -->
            <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                          HorizontalScrollMode="Enabled"
                          VerticalScrollBarVisibility="Disabled"
                          VerticalScrollMode="Disabled">
                <SelectorBar x:Name="SelectorBar_Versions"
                             Margin="12,4,12,0"
                             SelectionChanged="SelectorBar_Versions_SelectionChanged" />
            </ScrollViewer>
        </Grid>

        <!--  各版本逐段排列；关掉滚动链，滚到头时不带着发行说明窗口外层的竖排 FlipView 翻页  -->
        <ScrollViewer x:Name="Scroller"
                      Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      HorizontalScrollMode="Disabled"
                      IsVerticalScrollChainingEnabled="False"
                      VerticalScrollBarVisibility="Auto"
                      ViewChanged="Scroller_ViewChanged">
            <ItemsControl x:Name="ItemsControl_Releases" Margin="24,0,24,24">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:ReleaseNoteEntry">
                        <StackPanel>
                            <Rectangle Height="1"
                                       Margin="0,8,0,0"
                                       Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                                       Visibility="{x:Bind ShowSeparator}" />
                            <!--  标题 + 预览版标记  -->
                            <StackPanel Margin="0,20,0,0"
                                        Orientation="Horizontal"
                                        Spacing="10">
                                <TextBlock FontSize="24"
                                           FontWeight="SemiBold"
                                           IsTextSelectionEnabled="True"
                                           Text="{x:Bind Title}" />
                                <Border Padding="6,1,6,2"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        CornerRadius="4"
                                        Visibility="{x:Bind IsPrerelease}">
                                    <TextBlock FontSize="12"
                                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                               Text="{x:Bind lang:Lang.UpdatePage_PreviewChannel}" />
                                </Border>
                            </StackPanel>
                            <!--  日期 · 发布页面  -->
                            <StackPanel Margin="0,4,0,0"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                <TextBlock VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="{x:Bind Date}" />
                                <HyperlinkButton Padding="4,2,4,2"
                                                 VerticalAlignment="Center"
                                                 Content="{x:Bind lang:Lang.UpdatePage_ReleasePage}"
                                                 NavigateUri="{x:Bind HtmlUri}"
                                                 Visibility="{x:Bind HasHtmlUri}" />
                            </StackPanel>
                            <sc:MarkdownView Margin="0,6,0,0"
                                             HardLineBreaks="True"
                                             Markdown="{x:Bind Body}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </Grid>

</UserControl>
