<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="Starward.Features.Background.FavorWallpaperPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lang="using:Starward.Language"
             xmlns:local="using:Starward.Features.Background"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:DefaultBindMode="OneWay"
             mc:Ignorable="d">

    <Grid MinHeight="360">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Margin="0,0,0,8"
                   FontSize="12"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="{x:Bind StatusText, Mode=OneWay}"
                   Visibility="{x:Bind StatusText, Mode=OneWay, Converter={StaticResource ObjectToVisibilityConverter}}" />

        <GridView x:Name="GridView_Items"
                  Grid.Row="1"
                  Padding="0"
                  HorizontalAlignment="Center"
                  IsItemClickEnabled="False"
                  ItemsSource="{x:Bind Items, Mode=OneWay}"
                  SelectionMode="None">
            <GridView.ItemContainerStyle>
                <Style BasedOn="{StaticResource DefaultGridViewItemStyle}" TargetType="GridViewItem">
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                </Style>
            </GridView.ItemContainerStyle>
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <!-- 封面 245×153 + 卡片 Margin 8；与抽卡 Pane 一样固定格子、靠容器宽度换行。 -->
                    <ItemsWrapGrid ItemHeight="145"
                                   ItemWidth="228"
                                   Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="local:FavorWallpaperView">
                    <local:FavorWallpaperCard View="{x:Bind}" />
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <ProgressRing Grid.Row="1"
                      Width="40"
                      Height="40"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      IsActive="{x:Bind IsLoading, Mode=OneWay}"
                      Visibility="{x:Bind IsLoading, Mode=OneWay}" />

        <TextBlock Grid.Row="1"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                   Text="{x:Bind ErrorText, Mode=OneWay}"
                   TextWrapping="Wrap"
                   Visibility="{x:Bind ErrorText, Mode=OneWay, Converter={StaticResource ObjectToVisibilityConverter}}" />
    </Grid>
</UserControl>
