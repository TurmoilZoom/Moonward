<?xml version="1.0" encoding="utf-8" ?>
<sf:WindowEx x:Class="Starward.Features.Gacha.ZZZGachaToolbox.ZZZGachaInfoWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lang="using:Starward.Language"
             xmlns:local="using:Starward.Features.Gacha"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sf="using:Starward.Frameworks"
             Title="ZZZGachaItemInfoWindow"
             x:DefaultBindMode="OneWay"
             mc:Ignorable="d">

    <Grid x:Name="RootGrid"
          Padding="0,40,0,0"
          Loaded="RootGrid_Loaded"
          RowSpacing="8"
          Unloaded="RootGrid_Unloaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>


        <!--
          工具栏按流程分组：获取数据 → 语言包处理 → 维护者发布。
          窄窗口时横向滚动，避免一排按钮挤在一起难辨职责。
        -->
        <ScrollViewer Margin="8,0,8,0"
                      HorizontalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Auto"
                      VerticalScrollBarVisibility="Disabled"
                      VerticalScrollMode="Disabled">
            <StackPanel Orientation="Horizontal" Spacing="16">

                <!--  获取数据：已登录账号优先；网页获取为降级  -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="Button_FetchWithGameRecord"
                            Command="{x:Bind FetchFromGameRecordCommand}"
                            Content="{x:Bind lang:Lang.ZZZGachaInfoWindow_FetchWithGameRecord}"
                            Style="{ThemeResource AccentButtonStyle}" />
                    <DropDownButton Content="{x:Bind lang:Lang.ZZZGachaInfoWindow_OpenWebCapture}">
                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuFlyoutItem Command="{x:Bind NavigateToMiyousheCommand}"
                                                Text="{x:Bind lang:Lang.ZZZGachaInfoWindow_Miyoushe}" />
                                <MenuFlyoutItem Command="{x:Bind NavigateToHoYoLABCommand}" Text="HoYoLAB" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <Button x:Name="Button_GetAllLanguages"
                            Command="{x:Bind GetAllLanguagesInfoCommand}"
                            Content="{x:Bind lang:Lang.ZZZGachaInfoWindow_FetchDataForAllLanguages}"
                            IsEnabled="False" />
                </StackPanel>

                <Border Width="1"
                        Margin="0,4"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <!--  语言包：选择后保存本地 / 导出 JSON  -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="Button_SelectAll"
                            Command="{x:Bind SelectAllLanguagesCommand}"
                            Content="{x:Bind lang:Lang.Common_SelectAll}"
                            IsEnabled="False" />
                    <Button x:Name="Button_SaveToDatabase"
                            Command="{x:Bind SaveToDatabaseCommand}"
                            Content="{x:Bind lang:Lang.ZZZGachaInfoWindow_SaveToDatabase}"
                            IsEnabled="False" />
                    <Button x:Name="Button_ExportFiles"
                            Command="{x:Bind ExportToFolderCommand}"
                            Content="{x:Bind lang:Lang.ZZZGachaInfoWindow_ExportToFolder}"
                            IsEnabled="False" />
                </StackPanel>

                <Border Width="1"
                        Margin="0,4"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <!--  维护者：PAT + 提交 GitHub metadata 分支  -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="Button_ManagePat"
                            Command="{x:Bind ManageGitHubPatCommand}"
                            Content="{x:Bind lang:Lang.ZZZGachaInfoWindow_ManageGitHubPat}" />
                    <Button x:Name="Button_PublishMetadata"
                            Command="{x:Bind PublishToMetadataBranchCommand}"
                            Content="{x:Bind lang:Lang.ZZZGachaInfoWindow_PublishToMetadata}"
                            IsEnabled="False" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>


        <TextBlock x:Name="TextBlock_Status"
                   Grid.Row="1"
                   Margin="12,0,12,0"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="{x:Bind StatusMessage}"
                   TextWrapping="Wrap" />


        <GridView x:Name="GridView_Languages"
                  Grid.Row="2"
                  Margin="8,0,8,0"
                  ItemsSource="{x:Bind GachaInfoResult}"
                  SelectionChanged="GridView_Languages_SelectionChanged"
                  SelectionMode="Multiple">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <Border Width="148">
                        <TextBlock Margin="12,0,12,0"
                                   VerticalAlignment="Center"
                                   IsTextScaleFactorEnabled="False"
                                   Text="{x:Bind}" />
                    </Border>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>


        <StackPanel Grid.Row="3"
                    Margin="40"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="4">
            <TextBlock Text="{x:Bind lang:Lang.ZZZGachaInfoWindow_ZZZGachaInfoWindowGuide}" TextWrapping="Wrap" />
            <TextBlock TextWrapping="Wrap">
                <Hyperlink x:Name="Hyperlink_MetadataRepo"
                           UnderlineStyle="None">
                    <Run x:Name="Run_MetadataRepoUrl" />
                </Hyperlink>
            </TextBlock>


        </StackPanel>



        <WebView2 x:Name="webview2"
                  Grid.Row="3"
                  Visibility="Collapsed" />



    </Grid>

</sf:WindowEx>
