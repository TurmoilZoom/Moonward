<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="Starward.Features.Gacha.GachaStatsCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cwc="using:CommunityToolkit.WinUI.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:helpers="using:Starward.Helpers"
             xmlns:lang="using:Starward.Language"
             xmlns:local="using:Starward.Features.Gacha"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sc="using:Starward.Controls"
             x:DefaultBindMode="OneWay"
             mc:Ignorable="d">

    <UserControl.Resources>
        <SolidColorBrush x:Key="Rarity5ForegroundBrush">#FFA500</SolidColorBrush>
        <SolidColorBrush x:Key="Rarity4ForegroundBrush">#C864E0</SolidColorBrush>
        <SolidColorBrush x:Key="Rarity3ForegroundBrush">#5EAAED</SolidColorBrush>
        <SolidColorBrush x:Key="Rarity2ForegroundBrush">#3BA272</SolidColorBrush>
        <!--  最高 / 次一级稀有度画刷：默认即 5★ / 4★。千星奇域常驻颂愿（WarpTypeStats.TopRarity = 4）由 ApplyRarityTier 改成 4★ / 3★ 配色；资源随卡片实例创建，改色只影响本卡。  -->
        <SolidColorBrush x:Key="TopRarityForegroundBrush">#FFA500</SolidColorBrush>
        <SolidColorBrush x:Key="SecondRarityForegroundBrush">#C864E0</SolidColorBrush>

        <Style BasedOn="{StaticResource BodyTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="None" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>

        <local:GachaPityProgressBackgroundBrushConverter x:Key="GachaPityProgressBackgroundBrushConverter" />

        <!--  紧凑视图（图标网格）资源：卡片入树前按 RecordViewMode 替换两个记录 ItemsControl 的 ItemsPanel / ItemTemplate，列表视图用下方 Rarity5RowTemplate / Rarity4RowTemplate。  -->
        <SolidColorBrush x:Key="TopRarityTileBackgroundBrush">#40FFA500</SolidColorBrush>
        <SolidColorBrush x:Key="SecondRarityTileBackgroundBrush">#40C864E0</SolidColorBrush>

        <!--  图标方块面板：方块等宽、一行铺满（卡片变宽时方块跟着放大），每行个数取卡片的 CompactColumns（0 = 自动，见 GachaTileLayout）。方块模板不写死宽高，由面板按算好的尺寸排列。  -->
        <ItemsPanelTemplate x:Key="GachaRecordTilePanelTemplate">
            <local:GachaTilePanel />
        </ItemsPanelTemplate>

        <!--  5★ 图标方块：图标 + 右上 UP 角标 + 同名悬停描边，下方迷你保底条 + 抽数。装饰层全部不参与命中，由根 Grid 统一接收指针与提示。
              方块内文字须显式 VerticalAlignment="Center"：Tight 行框只有字高，按默认 Stretch 排布会贴顶，不要依赖卡片的隐式 TextBlock 样式。  -->
        <DataTemplate x:Key="Rarity5TileTemplate" x:DataType="local:GachaLogItemEx">
            <Grid Background="Transparent"
                  PointerEntered="Grid_Rarity5Item_PointerEntered"
                  RowSpacing="2"
                  Tag="{x:Bind}"
                  sc:InstantTooltip.Placement="Top"
                  sc:InstantTooltip.Text="{x:Bind RecordTooltipText}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="16" />
                </Grid.RowDefinitions>
                <Border Background="{StaticResource TopRarityTileBackgroundBrush}"
                        CornerRadius="6"
                        IsHitTestVisible="False" />
                <sc:CachedImage CornerRadius="6"
                                IsHitTestVisible="False"
                                Source="{x:Bind Icon}" />
                <!--  图标缺失（新物品尚未同步维基）时退化为名称  -->
                <TextBlock Margin="2"
                           VerticalAlignment="Center"
                           FontSize="10"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           IsHitTestVisible="False"
                           IsTextScaleFactorEnabled="False"
                           LineHeight="12"
                           LineStackingStrategy="BlockLineHeight"
                           MaxLines="3"
                           Text="{x:Bind Name}"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="Wrap"
                           Visibility="{x:Bind Icon, Converter={StaticResource ObjectToVisibilityReversedConverter}}" />
                <Border Width="24"
                        Height="13"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Background="{StaticResource TopRarityForegroundBrush}"
                        CornerRadius="0,6,0,4"
                        IsHitTestVisible="False"
                        Visibility="{x:Bind IsUp, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="#FF1F1F1F"
                               IsTextScaleFactorEnabled="False"
                               Text="UP"
                               TextLineBounds="Tight" />
                </Border>
                <!--  同名悬停描边：复用列表视图的 IsPointerIn 联动  -->
                <Border BorderBrush="{StaticResource TopRarityForegroundBrush}"
                        BorderThickness="2"
                        CornerRadius="6"
                        IsHitTestVisible="False"
                        Visibility="{x:Bind IsPointerIn, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                <!--  迷你保底条：中性轨道 + 与列表同一转换器的绿/红条；不挂 GachaPityBarAnimation（方块内不做 Composition 缩放）  -->
                <Grid Grid.Row="1"
                      Background="{ThemeResource ControlFillColorSecondaryBrush}"
                      CornerRadius="4"
                      IsHitTestVisible="False">
                    <Border Background="{x:Bind Converter={StaticResource GachaPityProgressBackgroundBrushConverter}}" CornerRadius="4" />
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               IsTextScaleFactorEnabled="False"
                               Text="{x:Bind Pity}"
                               TextLineBounds="Tight" />
                </Grid>
            </Grid>
        </DataTemplate>

        <!--  4★ 图标方块：结构同 5★，无 UP 角标；4★ 抽数不超过 10，底部只显示轨道与抽数、不画保底条。  -->
        <DataTemplate x:Key="Rarity4TileTemplate" x:DataType="local:GachaLogItemEx">
            <Grid Background="Transparent"
                  PointerEntered="Grid_Rarity4Item_PointerEntered"
                  RowSpacing="2"
                  Tag="{x:Bind}"
                  sc:InstantTooltip.Placement="Top"
                  sc:InstantTooltip.Text="{x:Bind RecordTooltipText}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="16" />
                </Grid.RowDefinitions>
                <Border Background="{StaticResource SecondRarityTileBackgroundBrush}"
                        CornerRadius="6"
                        IsHitTestVisible="False" />
                <sc:CachedImage CornerRadius="6"
                                IsHitTestVisible="False"
                                Source="{x:Bind Icon}" />
                <TextBlock Margin="2"
                           VerticalAlignment="Center"
                           FontSize="10"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           IsHitTestVisible="False"
                           IsTextScaleFactorEnabled="False"
                           LineHeight="12"
                           LineStackingStrategy="BlockLineHeight"
                           MaxLines="3"
                           Text="{x:Bind Name}"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="Wrap"
                           Visibility="{x:Bind Icon, Converter={StaticResource ObjectToVisibilityReversedConverter}}" />
                <Border BorderBrush="{StaticResource SecondRarityForegroundBrush}"
                        BorderThickness="2"
                        CornerRadius="6"
                        IsHitTestVisible="False"
                        Visibility="{x:Bind IsPointerIn, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                <Grid Grid.Row="1"
                      Background="{ThemeResource ControlFillColorSecondaryBrush}"
                      CornerRadius="4"
                      IsHitTestVisible="False">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               IsTextScaleFactorEnabled="False"
                               Text="{x:Bind Pity}"
                               TextLineBounds="Tight" />
                </Grid>
            </Grid>
        </DataTemplate>

        <!--  列表视图的记录行：放在资源里，供不分组时的两个记录 ItemsControl 与按版本分组的组模板共用。  -->
        <DataTemplate x:Key="Rarity5RowTemplate" x:DataType="local:GachaLogItemEx">
            <Grid Name="Grid_Rarity5Item"
                  Height="28"
                  Background="Transparent"
                  PointerEntered="Grid_Rarity5Item_PointerEntered"
                  Tag="{x:Bind}"
                  sc:InstantTooltip.Placement="Top"
                  sc:InstantTooltip.Text="{x:Bind Time.ToString('yyyy-MM-dd HH:mm:ss', x:Null)}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" MinWidth="20" />
                </Grid.ColumnDefinitions>
                <Border x:Name="PityBar"
                        Grid.Column="1"
                        Height="24"
                        Margin="-4,0,-4,0"
                        VerticalAlignment="Center"
                        Background="{x:Bind Converter={StaticResource GachaPityProgressBackgroundBrushConverter}}"
                        CornerRadius="4"
                        local:GachaPityBarAnimation.AnimateOnLoad="True" />
                <sc:CachedImage Width="28"
                                Height="28"
                                HorizontalAlignment="Left"
                                Source="{x:Bind Icon}" />
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           Text="{x:Bind Name}"
                           TextTrimming="CharacterEllipsis"
                           Visibility="{x:Bind IsPointerIn, Converter={StaticResource BoolToVisibilityReversedConverter}}" />
                <TextBlock Grid.Column="3"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           IsTextScaleFactorEnabled="False"
                           Text="{x:Bind Pity}"
                           Visibility="{x:Bind IsPointerIn, Converter={StaticResource BoolToVisibilityReversedConverter}}" />
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TopRarityForegroundBrush}"
                           Text="{x:Bind Name}"
                           TextTrimming="CharacterEllipsis"
                           Visibility="{x:Bind IsPointerIn, Converter={StaticResource BoolToVisibilityConverter}}" />
                <TextBlock Grid.Column="3"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TopRarityForegroundBrush}"
                           IsTextScaleFactorEnabled="False"
                           Text="{x:Bind Pity}"
                           Visibility="{x:Bind IsPointerIn, Converter={StaticResource BoolToVisibilityConverter}}" />
                <TextBlock Grid.Column="2"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontSize="12"
                           FontStyle="Italic"
                           Foreground="{ThemeResource TopRarityForegroundBrush}"
                           IsTextScaleFactorEnabled="False"
                           Opacity="{x:Bind UpTextOpacity}"
                           Text="up!"
                           Visibility="{x:Bind HasUpItem, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="Rarity4RowTemplate" x:DataType="local:GachaLogItemEx">
            <Grid Name="Grid_Rarity4Item"
                  Height="28"
                  Background="Transparent"
                  ColumnSpacing="8"
                  PointerEntered="Grid_Rarity4Item_PointerEntered"
                  Tag="{x:Bind}"
                  sc:InstantTooltip.Placement="Top"
                  sc:InstantTooltip.Text="{x:Bind Time.ToString('yyyy-MM-dd HH:mm:ss', x:Null)}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="24" />
                </Grid.ColumnDefinitions>
                <sc:CachedImage Width="28"
                                Height="28"
                                Source="{x:Bind Icon}" />
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           Text="{x:Bind Name}"
                           TextTrimming="CharacterEllipsis"
                           Visibility="{x:Bind IsPointerIn, Converter={StaticResource BoolToVisibilityReversedConverter}}" />
                <TextBlock Grid.Column="2"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Text="{x:Bind Pity}"
                           Visibility="{x:Bind IsPointerIn, Converter={StaticResource BoolToVisibilityReversedConverter}}" />
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource SecondRarityForegroundBrush}"
                           Text="{x:Bind Name}"
                           TextTrimming="CharacterEllipsis"
                           Visibility="{x:Bind IsPointerIn, Converter={StaticResource BoolToVisibilityConverter}}" />
                <TextBlock Grid.Column="2"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource SecondRarityForegroundBrush}"
                           Text="{x:Bind Pity}"
                           Visibility="{x:Bind IsPointerIn, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>
        </DataTemplate>

        <!--  按版本分组：外层各版本竖排，组内沿用列表行 / 图标方块模板。卡片入树前按 GroupByVersion 与 RecordViewMode 选用（见 ApplyRecordList）。  -->
        <ItemsPanelTemplate x:Key="GachaRecordStackPanelTemplate">
            <StackPanel />
        </ItemsPanelTemplate>

        <DataTemplate x:Key="Rarity5RowGroupTemplate" x:DataType="local:GachaVersionGroup">
            <StackPanel>
                <Grid Height="22" Margin="0,4,0,0">
                    <TextBlock FontSize="12"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Text="{x:Bind Header, Mode=OneTime}" />
                </Grid>
                <ItemsControl ItemTemplate="{StaticResource Rarity5RowTemplate}"
                              ItemsSource="{x:Bind Items, Mode=OneTime}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="Rarity4RowGroupTemplate" x:DataType="local:GachaVersionGroup">
            <StackPanel>
                <Grid Height="22" Margin="0,4,0,0">
                    <TextBlock FontSize="12"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Text="{x:Bind Header, Mode=OneTime}" />
                </Grid>
                <ItemsControl ItemTemplate="{StaticResource Rarity4RowTemplate}"
                              ItemsSource="{x:Bind Items, Mode=OneTime}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="Rarity5TileGroupTemplate" x:DataType="local:GachaVersionGroup">
            <StackPanel>
                <Grid Height="22" Margin="0,4,0,4">
                    <TextBlock FontSize="12"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Text="{x:Bind Header, Mode=OneTime}" />
                </Grid>
                <ItemsControl ItemTemplate="{StaticResource Rarity5TileTemplate}" ItemsPanel="{StaticResource GachaRecordTilePanelTemplate}"
                              ItemsSource="{x:Bind Items, Mode=OneTime}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="Rarity4TileGroupTemplate" x:DataType="local:GachaVersionGroup">
            <StackPanel>
                <Grid Height="22" Margin="0,4,0,4">
                    <TextBlock FontSize="12"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Text="{x:Bind Header, Mode=OneTime}" />
                </Grid>
                <ItemsControl ItemTemplate="{StaticResource Rarity4TileTemplate}" ItemsPanel="{StaticResource GachaRecordTilePanelTemplate}"
                              ItemsSource="{x:Bind Items, Mode=OneTime}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Padding="12,8,12,8"
          Background="{ThemeResource CustomOverlayAcrylicBrush}"
          CornerRadius="8"
          RowSpacing="4"
          Shadow="{ThemeResource ThemeShadow}"
          Translation="0,0,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Name="TextBlock_GachaTypeText"
                       FontSize="16"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       IsTextTrimmedChanged="TextBlock_GachaTypeText_IsTextTrimmedChanged"
                       Text="{x:Bind WarpTypeStats.GachaTypeText}"
                       TextTrimming="CharacterEllipsis" />
            <Border Grid.Column="1"
                    Padding="6,1,6,1"
                    VerticalAlignment="Center"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    CornerRadius="9"
                    Visibility="{x:Bind WarpTypeStats.ShowFiftyFiftyUpStreakCapsule, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock FontSize="11"
                           Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                           IsTextScaleFactorEnabled="False"
                           Text="{x:Bind WarpTypeStats.MaxFiftyFiftyUpStreakText}" />
            </Border>
            <Border Grid.Column="2"
                    Padding="6,1,6,1"
                    VerticalAlignment="Center"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    CornerRadius="9"
                    Visibility="{x:Bind WarpTypeStats.ShowFiftyFiftyMissStreakCapsule, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock FontSize="11"
                           Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                           IsTextScaleFactorEnabled="False"
                           Text="{x:Bind WarpTypeStats.MaxFiftyFiftyMissStreakText}" />
            </Border>
            <TextBlock Grid.Column="3"
                       FontSize="16"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="{x:Bind WarpTypeStats.Count}" />
        </Grid>


        <TextBlock Grid.Row="1"
                   FontSize="12"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   TextTrimming="CharacterEllipsis">
            <Run Text="{x:Bind WarpTypeStats.StartTime.ToString('yyyy/MM/dd HH:mm:ss', x:Null)}" />
            <Run Text="-" />
            <Run Text="{x:Bind WarpTypeStats.EndTime.ToString('yyyy/MM/dd HH:mm:ss', x:Null)}" />
        </TextBlock>

        <MenuFlyoutSeparator Grid.Row="2" />

        <!--  5★ 平均  -->
        <TextBlock Grid.Row="3" Foreground="{ThemeResource Rarity2ForegroundBrush}">
            <Run Text="{x:Bind WarpTypeStats.TopRarityText}" />
            <Run Text="{x:Bind lang:Lang.GachaStatsCard_Average}" /><Run Text="{x:Bind WarpTypeStats.Avarage_5_Desc_Text}" />
        </TextBlock>
        <TextBlock Grid.Row="3"
                   HorizontalAlignment="Right"
                   Foreground="{ThemeResource Rarity2ForegroundBrush}">
            <Run Text="{x:Bind WarpTypeStats.Average_5_Text}" /><Run Text="{x:Bind WarpTypeStats.Avarage_5_Up_Text}" />
        </TextBlock>

        <!--  5★ 统计（非 UP 卡池显示）；UP 卡池此行改为显示「不歪概率」，二者互斥同占第 4 行  -->
        <TextBlock Grid.Row="4"
                   Foreground="{ThemeResource TopRarityForegroundBrush}"
                   Visibility="{x:Bind WarpTypeStats.HasUpItem, Converter={StaticResource BoolToVisibilityReversedConverter}}">
            <Run Text="{x:Bind WarpTypeStats.TopRarityText}" />
            <Run Text="{x:Bind lang:Lang.GachaStatsCard_Stats}" />
        </TextBlock>
        <TextBlock Grid.Row="4"
                   HorizontalAlignment="Right"
                   HorizontalTextAlignment="Left"
                   Foreground="{ThemeResource TopRarityForegroundBrush}"
                   Visibility="{x:Bind WarpTypeStats.HasUpItem, Converter={StaticResource BoolToVisibilityReversedConverter}}">
            <Run Text="{x:Bind WarpTypeStats.Count_5}" />
            <Run Text="[" /><Run Text="{x:Bind WarpTypeStats.Ratio_5.ToString('P2', x:Null)}" /><Run Text="]" />
        </TextBlock>

        <!--  不歪概率（仅 UP 卡池显示）：小保底抽到当期 UP 的概率，形如 54.55% (6/11)  -->
        <TextBlock Grid.Row="4"
                   Foreground="{ThemeResource TopRarityForegroundBrush}"
                   Visibility="{x:Bind WarpTypeStats.HasUpItem, Converter={StaticResource BoolToVisibilityConverter}}">
            <Run Text="{x:Bind lang:Lang.GachaStatsCard_NoUpProbability}" />
        </TextBlock>
        <TextBlock Grid.Row="4"
                   HorizontalAlignment="Right"
                   HorizontalTextAlignment="Left"
                   Foreground="{ThemeResource TopRarityForegroundBrush}"
                   Text="{x:Bind WarpTypeStats.FiftyFiftyNoUpText}"
                   Visibility="{x:Bind WarpTypeStats.HasUpItem, Converter={StaticResource BoolToVisibilityConverter}}" />

        <!--  当前最高稀有度垫数：限定池同时标明下一次为小保底还是大保底。  -->
        <Grid Grid.Row="5"
              Margin="0,2,0,4"
              RowSpacing="3"
              Visibility="{x:Bind WarpTypeStats.ShowPityProgress, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <TextBlock FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="{x:Bind WarpTypeStats.PityProgressText}" />
                <TextBlock HorizontalAlignment="Right"
                           FontSize="12"
                           Foreground="{ThemeResource TopRarityForegroundBrush}"
                           Text="{x:Bind WarpTypeStats.PityGuaranteeText}"
                           Visibility="{x:Bind WarpTypeStats.HasUpItem, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>
            <ProgressBar Grid.Row="1"
                         Height="6"
                         HorizontalAlignment="Stretch"
                         Background="{ThemeResource ControlFillColorSecondaryBrush}"
                         CornerRadius="3"
                         Foreground="{ThemeResource TopRarityForegroundBrush}"
                         Maximum="{x:Bind WarpTypeStats.Pity_5_Max}"
                         Value="{x:Bind WarpTypeStats.Pity_5}" />
        </Grid>

        <!--  拖拽手柄：覆盖 tab 标签上方的卡池统计信息区域（第 0~5 行），按住此处可拖动整张卡片换位。  -->
        <Border x:Name="DragHandleBorder"
                Grid.Row="0"
                Grid.RowSpan="6"
                Background="Transparent"
                helpers:PointerCursor.CursorShape="Hand" />

        <Grid Grid.Row="6"
              RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <cwc:Segmented x:Name="Segmented_GachaItemList"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Center"
                           SelectedIndex="0">
                <cwc:SegmentedItem>
                    <TextBlock Foreground="{ThemeResource TopRarityForegroundBrush}" Text="{x:Bind WarpTypeStats.TopRarityText}" />
                </cwc:SegmentedItem>
                <cwc:SegmentedItem>
                    <TextBlock Foreground="{ThemeResource SecondRarityForegroundBrush}" Text="{x:Bind WarpTypeStats.SecondRarityText}" />
                </cwc:SegmentedItem>
            </cwc:Segmented>

            <!--  记录列表：竖直滚动条隐藏（VerticalScrollMode 仍为 Enabled，保留鼠标滚轮与拖拽滚动）。统计信息与 Segmented 选项卡在其上方、不随列表滚动。  -->
            <ScrollViewer x:Name="ScrollViewer_GachaItemList"
                          Grid.Row="1"
                          HorizontalScrollBarVisibility="Disabled"
                          HorizontalScrollMode="Disabled"
                          VerticalScrollBarVisibility="Hidden"
                          VerticalScrollMode="Enabled">
                <Grid>
            <!--  行高固定、数量有限：用 ItemsControl 避免 ItemsRepeater 虚拟化在跨显示器 DPI 变化时 MeasureOverride 失败。
                  ItemsSource / ItemTemplate / ItemsPanel 由 ApplyRecordList 在入树前按视图与是否按版本分组设置。  -->
            <ItemsControl x:Name="ItemsRepeater_List_5" ItemTemplate="{StaticResource Rarity5RowTemplate}" />

            <ItemsControl x:Name="ItemsRepeater_List_4" ItemTemplate="{StaticResource Rarity4RowTemplate}" />
                </Grid>
            </ScrollViewer>
        </Grid>


    </Grid>

</UserControl>
