<?xml version="1.0" encoding="utf-8" ?>
<sf:WindowEx x:Class="Starward.Features.Gacha.UIGF.UIGF4GachaWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cc="using:Starward.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lang="using:Starward.Language"
             xmlns:local="using:Starward.Features.Gacha.UIGF"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mxi="using:Microsoft.Xaml.Interactivity"
             xmlns:sf="using:Starward.Frameworks"
             xmlns:sh="using:Starward.Helpers"
             Title="GachaImportAndExportWindow"
             x:DefaultBindMode="OneWay"
             mc:Ignorable="d">

    <Grid x:Name="RootGrid"
          Loaded="RootGrid_Loaded"
          Unloaded="RootGrid_Unloaded">
        <Grid.Resources>
            <!--  共享列宽：表头占位单元与列表行单元绑定同一资源，配合相同的 ColumnSpacing 与左缩进自动对齐，无需手算累加边距。  -->
            <x:Double x:Key="GachaColIcon">36</x:Double>
            <x:Double x:Key="GachaColUid">96</x:Double>
            <x:Double x:Key="GachaColCount">56</x:Double>
            <x:Double x:Key="GachaColTime">150</x:Double>
            <x:Double x:Key="GachaColName">160</x:Double>
            <x:Double x:Key="GachaColOffset">140</x:Double>

            <!--  列表项左内边距 12 与表头左边距 12 一致，使表头与各列严格对齐；选中高亮铺满整行宽度。  -->
            <Style x:Key="GachaArchiveItemStyle"
                   BasedOn="{StaticResource DefaultListViewItemStyle}"
                   TargetType="ListViewItem">
                <Setter Property="Margin" Value="0,1,0,1" />
                <Setter Property="Padding" Value="12,6,12,6" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <TextBlock Margin="12,0,0,0"
                   VerticalAlignment="Center"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}">
            <Run Text="{x:Bind lang:Lang.ToolboxSetting_GachaRecordsImportExport}" />
            <Run Text="(UIGF v4.0)" />
        </TextBlock>


        <Pivot x:Name="Pivot_ExportImport" Grid.Row="1">
            <Pivot.Resources>
                <Thickness x:Key="PivotItemMargin">0,0,0,0</Thickness>
                <Thickness x:Key="PivotHeaderItemMargin">12,0,12,0</Thickness>
                <Style BasedOn="{StaticResource DefaultPivotHeaderItemStyle}" TargetType="PivotHeaderItem">
                    <Setter Property="Height" Value="36" />
                    <Setter Property="FontSize" Value="16" />
                    <Setter Property="FontWeight" Value="Bold" />
                </Style>
            </Pivot.Resources>

            <!--  导出  -->
            <PivotItem Header="{x:Bind lang:Lang.GachaImportAndExportWindow_Export}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="12,4,12,0"
                                Orientation="Horizontal"
                                Spacing="12">
                        <TextBlock VerticalAlignment="Center" Text="{x:Bind lang:Lang.GachaImportAndExportWindow_SelectTheGachaRecordsToExport}" />
                        <Button x:Name="Button_Export"
                                Command="{x:Bind ExportCommand}"
                                Content="{x:Bind lang:Lang.GachaImportAndExportWindow_Export}" />
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                   Text="{x:Bind ExportError}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <!--  表头  -->
                    <Grid Grid.Row="1"
                          Margin="12,12,12,2"
                          ColumnSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0"
                                   Grid.Column="3"
                                   Grid.ColumnSpan="3"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="{x:Bind lang:Lang.GachaImportAndExportWindow_TheLastGachaPull}" />
                        <Border Grid.Row="1"
                                Grid.Column="0"
                                Width="{StaticResource GachaColIcon}" />
                        <TextBlock Grid.Row="1"
                                   Grid.Column="1"
                                   Width="{StaticResource GachaColUid}"
                                   VerticalAlignment="Bottom"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Uid" />
                        <TextBlock Grid.Row="1"
                                   Grid.Column="2"
                                   Width="{StaticResource GachaColCount}"
                                   VerticalAlignment="Bottom"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="{x:Bind lang:Lang.GachaImportAndExportWindow_Count}" />
                        <TextBlock Grid.Row="1"
                                   Grid.Column="3"
                                   Width="{StaticResource GachaColTime}"
                                   VerticalAlignment="Bottom"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="{x:Bind lang:Lang.GachaImportAndExportWindow_TimeServerTimeZone}" />
                        <TextBlock Grid.Row="1"
                                   Grid.Column="4"
                                   Width="{StaticResource GachaColName}"
                                   VerticalAlignment="Bottom"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="{x:Bind lang:Lang.GachaImportAndExportWindow_Name}" />
                    </Grid>

                    <ListView x:Name="ListView_Export"
                              Grid.Row="2"
                              Padding="0,0,0,12"
                              ItemContainerStyle="{StaticResource GachaArchiveItemStyle}"
                              ItemsSource="{x:Bind GachaExportArchives}"
                              SelectionMode="Multiple">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:GachaUidArchiveDisplay">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <cc:CachedImage Grid.Column="0"
                                                    Width="{StaticResource GachaColIcon}"
                                                    Height="{StaticResource GachaColIcon}"
                                                    CornerRadius="8"
                                                    Source="{x:Bind GameIcon}" />
                                    <TextBlock Grid.Column="1"
                                               Width="{StaticResource GachaColUid}"
                                               VerticalAlignment="Center"
                                               Text="{x:Bind Uid}" />
                                    <TextBlock Grid.Column="2"
                                               Width="{StaticResource GachaColCount}"
                                               VerticalAlignment="Center"
                                               Text="{x:Bind Count}" />
                                    <TextBlock Grid.Column="3"
                                               Width="{StaticResource GachaColTime}"
                                               VerticalAlignment="Center"
                                               Text="{x:Bind LastItemTime.ToString('yyyy-MM-dd HH:mm:ss', x:Null)}" />
                                    <TextBlock Grid.Column="4"
                                               Width="{StaticResource GachaColName}"
                                               VerticalAlignment="Center"
                                               Text="{x:Bind LastItemName}"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                </Grid>
            </PivotItem>

            <!--  导入  -->
            <PivotItem Header="{x:Bind lang:Lang.GachaImportAndExportWindow_Import}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="12,4,12,0"
                                Orientation="Horizontal"
                                Spacing="12">
                        <TextBlock VerticalAlignment="Center" Text="{x:Bind lang:Lang.GachaImportAndExportWindow_SelectTheFileToImport}" />
                        <Button x:Name="Button_SelectFile"
                                Command="{x:Bind SelectFileCommand}"
                                Content="{x:Bind lang:Lang.GachaImportAndExportWindow_SelectFile}" />
                        <Button x:Name="Button_SelectAllImport"
                                Click="Button_SelectAllImport_Click"
                                Content="{x:Bind lang:Lang.Common_SelectAll}" />
                        <Button x:Name="Button_Import"
                                Command="{x:Bind ImportCommand}"
                                Content="{x:Bind lang:Lang.GachaImportAndExportWindow_Import}" />
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                   Text="{x:Bind ImportError}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <TextBlock Grid.Row="1"
                               Margin="12,8,12,0"
                               Foreground="{ThemeResource SystemFillColorCautionBrush}"
                               Text="{x:Bind lang:Lang.GachaImportAndExportWindow_TimeZoneOffsetWarning}"
                               TextWrapping="Wrap" />

                    <!--  表头  -->
                    <Grid Grid.Row="2"
                          Margin="12,12,12,2"
                          ColumnSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0"
                                   Grid.Column="3"
                                   Grid.ColumnSpan="5"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="{x:Bind lang:Lang.GachaImportAndExportWindow_TheLastGachaPull}" />
                        <Border Grid.Row="1"
                                Grid.Column="0"
                                Width="{StaticResource GachaColIcon}" />
                        <TextBlock Grid.Row="1"
                                   Grid.Column="1"
                                   Width="{StaticResource GachaColUid}"
                                   VerticalAlignment="Bottom"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Uid" />
                        <TextBlock Grid.Row="1"
                                   Grid.Column="2"
                                   Width="{StaticResource GachaColCount}"
                                   VerticalAlignment="Bottom"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="{x:Bind lang:Lang.GachaImportAndExportWindow_Count}" />
                        <TextBlock Grid.Row="1"
                                   Grid.Column="3"
                                   Width="{StaticResource GachaColTime}"
                                   VerticalAlignment="Bottom"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="{x:Bind lang:Lang.GachaImportAndExportWindow_TimeServerTimeZone}" />
                        <TextBlock Grid.Row="1"
                                   Grid.Column="4"
                                   Width="{StaticResource GachaColName}"
                                   VerticalAlignment="Bottom"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="{x:Bind lang:Lang.GachaImportAndExportWindow_Name}" />
                        <TextBlock Grid.Row="1"
                                   Grid.Column="5"
                                   Width="{StaticResource GachaColOffset}"
                                   VerticalAlignment="Bottom"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="{x:Bind lang:Lang.GachaImportAndExportWindow_TimeZoneOffset}" />
                        <TextBlock Grid.Row="1"
                                   Grid.Column="6"
                                   Width="{StaticResource GachaColTime}"
                                   VerticalAlignment="Bottom"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="{x:Bind lang:Lang.GachaImportAndExportWindow_OffsetTime}" />
                    </Grid>


                    <ListView x:Name="ListView_Import"
                              Grid.Row="3"
                              Padding="0,0,0,12"
                              ItemContainerStyle="{StaticResource GachaArchiveItemStyle}"
                              ItemsSource="{x:Bind GachaImportArchives}"
                              SelectionMode="Multiple">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:GachaUidArchiveDisplay">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <cc:CachedImage Grid.Column="0"
                                                    Width="{StaticResource GachaColIcon}"
                                                    Height="{StaticResource GachaColIcon}"
                                                    CornerRadius="8"
                                                    Source="{x:Bind GameIcon}" />
                                    <TextBlock Grid.Column="1"
                                               Width="{StaticResource GachaColUid}"
                                               VerticalAlignment="Center"
                                               Text="{x:Bind Uid}" />
                                    <TextBlock Grid.Column="2"
                                               Width="{StaticResource GachaColCount}"
                                               VerticalAlignment="Center"
                                               Text="{x:Bind Count}" />
                                    <TextBlock Grid.Column="3"
                                               Width="{StaticResource GachaColTime}"
                                               VerticalAlignment="Center"
                                               Text="{x:Bind LastItemTime.ToString('yyyy-MM-dd HH:mm:ss', x:Null)}" />
                                    <TextBlock Grid.Column="4"
                                               Width="{StaticResource GachaColName}"
                                               VerticalAlignment="Center"
                                               Text="{x:Bind LastItemName}"
                                               TextTrimming="CharacterEllipsis" />
                                    <NumberBox Grid.Column="5"
                                               Width="{StaticResource GachaColOffset}"
                                               VerticalAlignment="Center"
                                               SpinButtonPlacementMode="Inline"
                                               Value="{x:Bind Timezone, Mode=TwoWay}" />
                                    <TextBlock Grid.Column="6"
                                               Width="{StaticResource GachaColTime}"
                                               VerticalAlignment="Center"
                                               Text="{x:Bind LastItemTimeOffest.ToString('yyyy-MM-dd HH:mm:ss', x:Null)}" />
                                    <TextBlock Grid.Column="7"
                                               VerticalAlignment="Center"
                                               Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                               Text="{x:Bind Result}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="7"
                                               VerticalAlignment="Center"
                                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                               Text="{x:Bind Error}"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                </Grid>
            </PivotItem>


        </Pivot>


        <StackPanel x:Name="StackPanel_InAppToast"
                    Grid.Row="1"
                    MaxWidth="600"
                    Margin="24,24,24,24"
                    VerticalAlignment="Bottom">
            <StackPanel.Transitions>
                <TransitionCollection>
                    <AddDeleteThemeTransition />
                </TransitionCollection>
            </StackPanel.Transitions>
            <mxi:Interaction.Behaviors>
                <sh:InAppToast />
            </mxi:Interaction.Behaviors>
        </StackPanel>


    </Grid>
</sf:WindowEx>
