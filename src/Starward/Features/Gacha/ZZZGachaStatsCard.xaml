<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="Starward.Features.Gacha.ZZZGachaStatsCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cwc="using:CommunityToolkit.WinUI.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:helpers="using:Starward.Helpers"
             xmlns:lang="using:Starward.Language"
             xmlns:local="using:Starward.Features.Gacha"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sc="using:Starward.Controls"
             x:DefaultBindMode="OneWay"
             mc:Ignorable="d">

    <UserControl.Resources>
        <SolidColorBrush x:Key="Rarity5ForegroundBrush">#FFA500</SolidColorBrush>
        <SolidColorBrush x:Key="Rarity4ForegroundBrush">#C864E0</SolidColorBrush>
        <SolidColorBrush x:Key="Rarity3ForegroundBrush">#5EAAED</SolidColorBrush>
        <SolidColorBrush x:Key="Rarity2ForegroundBrush">#3BA272</SolidColorBrush>

        <Style BasedOn="{StaticResource BodyTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="None" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>

        <local:GachaPityProgressBackgroundBrushConverter x:Key="GachaPityProgressBackgroundBrushConverter" />
    </UserControl.Resources>

    <Grid Padding="12,8,12,8"
          Background="{ThemeResource CustomOverlayAcrylicBrush}"
          CornerRadius="8"
          RowSpacing="4"
          Shadow="{ThemeResource ThemeShadow}"
          Translation="0,0,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Name="TextBlock_GachaTypeText"
                       FontSize="16"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       IsTextTrimmedChanged="TextBlock_GachaTypeText_IsTextTrimmedChanged"
                       Text="{x:Bind WarpTypeStats.GachaTypeText}"
                       TextTrimming="CharacterEllipsis" />
            <Border Grid.Column="1"
                    Padding="6,1,6,1"
                    VerticalAlignment="Center"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    CornerRadius="9"
                    Visibility="{x:Bind WarpTypeStats.ShowFiftyFiftyUpStreakCapsule, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock FontSize="11"
                           Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                           IsTextScaleFactorEnabled="False"
                           Text="{x:Bind WarpTypeStats.MaxFiftyFiftyUpStreakText}" />
            </Border>
            <Border Grid.Column="2"
                    Padding="6,1,6,1"
                    VerticalAlignment="Center"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    CornerRadius="9"
                    Visibility="{x:Bind WarpTypeStats.ShowFiftyFiftyMissStreakCapsule, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock FontSize="11"
                           Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                           IsTextScaleFactorEnabled="False"
                           Text="{x:Bind WarpTypeStats.MaxFiftyFiftyMissStreakText}" />
            </Border>
            <TextBlock Grid.Column="3"
                       FontSize="16"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="{x:Bind WarpTypeStats.Count}" />
        </Grid>


        <TextBlock Grid.Row="1"
                   FontSize="12"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   TextTrimming="CharacterEllipsis">
            <Run Text="{x:Bind WarpTypeStats.StartTime.ToString('yyyy/MM/dd HH:mm:ss', x:Null)}" />
            <Run Text="-" />
            <Run Text="{x:Bind WarpTypeStats.EndTime.ToString('yyyy/MM/dd HH:mm:ss', x:Null)}" />
        </TextBlock>

        <MenuFlyoutSeparator Grid.Row="2" />

        <!--  5★ 平均  -->
        <TextBlock Grid.Row="3" Foreground="{ThemeResource Rarity2ForegroundBrush}">
            <Run Text="S" />
            <Run Text="{x:Bind lang:Lang.GachaStatsCard_Average}" />
            <Run Text="{x:Bind WarpTypeStats.Avarage_5_Desc_Text}" />
        </TextBlock>
        <TextBlock Grid.Row="3"
                   HorizontalAlignment="Right"
                   Foreground="{ThemeResource Rarity2ForegroundBrush}">
            <Run Text="{x:Bind WarpTypeStats.Average_5.ToString('F2', x:Null)}" /><Run Text="{x:Bind WarpTypeStats.Avarage_5_Up_Text}" />
        </TextBlock>

        <!--  S 统计（非 UP 频段显示）；UP 频段此行改为显示「不歪概率」，二者互斥同占第 4 行  -->
        <TextBlock Grid.Row="4"
                   Foreground="{ThemeResource Rarity5ForegroundBrush}"
                   Visibility="{x:Bind WarpTypeStats.HasUpItem, Converter={StaticResource BoolToVisibilityReversedConverter}}">
            <Run Text="S" />
            <Run Text="{x:Bind lang:Lang.GachaStatsCard_Stats}" />
        </TextBlock>
        <TextBlock Grid.Row="4"
                   HorizontalAlignment="Right"
                   HorizontalTextAlignment="Left"
                   Foreground="{ThemeResource Rarity5ForegroundBrush}"
                   Visibility="{x:Bind WarpTypeStats.HasUpItem, Converter={StaticResource BoolToVisibilityReversedConverter}}">
            <Run Text="{x:Bind WarpTypeStats.Count_5}" />
            <Run Text="[" /><Run Text="{x:Bind WarpTypeStats.Ratio_5.ToString('P2', x:Null)}" /><Run Text="]" />
        </TextBlock>

        <!--  不歪概率（仅 UP 频段显示）：小保底 50/50 抽到当期 UP 的概率，形如 54.55% (6/11)  -->
        <TextBlock Grid.Row="4"
                   Foreground="{ThemeResource Rarity5ForegroundBrush}"
                   Visibility="{x:Bind WarpTypeStats.HasUpItem, Converter={StaticResource BoolToVisibilityConverter}}">
            <Run Text="{x:Bind lang:Lang.GachaStatsCard_NoUpProbability}" />
        </TextBlock>
        <TextBlock Grid.Row="4"
                   HorizontalAlignment="Right"
                   HorizontalTextAlignment="Left"
                   Foreground="{ThemeResource Rarity5ForegroundBrush}"
                   Text="{x:Bind WarpTypeStats.FiftyFiftyNoUpText}"
                   Visibility="{x:Bind WarpTypeStats.HasUpItem, Converter={StaticResource BoolToVisibilityConverter}}" />

        <!--  当前最高稀有度垫数：限定频段同时标明下一次为小保底还是大保底。  -->
        <Grid Grid.Row="5"
              Margin="0,2,0,4"
              RowSpacing="3"
              Visibility="{x:Bind WarpTypeStats.ShowPityProgress, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <TextBlock FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="{x:Bind WarpTypeStats.PityProgressText}" />
                <TextBlock HorizontalAlignment="Right"
                           FontSize="12"
                           Foreground="{ThemeResource Rarity5ForegroundBrush}"
                           Text="{x:Bind WarpTypeStats.PityGuaranteeText}"
                           Visibility="{x:Bind WarpTypeStats.HasUpItem, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>
            <ProgressBar Grid.Row="1"
                         Height="6"
                         HorizontalAlignment="Stretch"
                         Background="{ThemeResource ControlFillColorSecondaryBrush}"
                         CornerRadius="3"
                         Foreground="{ThemeResource Rarity5ForegroundBrush}"
                         Maximum="{x:Bind WarpTypeStats.Pity_5_Max}"
                         Value="{x:Bind WarpTypeStats.Pity_5}" />
        </Grid>

        <!--  拖拽手柄：覆盖 tab 标签上方的卡池统计信息区域（第 0~5 行），按住此处可拖动整张卡片换位。  -->
        <Border x:Name="DragHandleBorder"
                Grid.Row="0"
                Grid.RowSpan="6"
                Background="Transparent"
                helpers:PointerCursor.CursorShape="Hand" />

        <Grid Grid.Row="6"
              RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <cwc:Segmented x:Name="Segmented_GachaItemList"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Center"
                           SelectedIndex="0">
                <cwc:SegmentedItem>
                    <TextBlock Foreground="{ThemeResource Rarity5ForegroundBrush}" Text="S" />
                </cwc:SegmentedItem>
                <cwc:SegmentedItem>
                    <TextBlock Foreground="{ThemeResource Rarity4ForegroundBrush}" Text="A" />
                </cwc:SegmentedItem>
            </cwc:Segmented>

            <!--  记录列表：竖直滚动条隐藏（VerticalScrollMode 仍为 Enabled，保留鼠标滚轮与拖拽滚动）。统计信息与 Segmented 选项卡在其上方、不随列表滚动。  -->
            <ScrollViewer x:Name="ScrollViewer_GachaItemList"
                          Grid.Row="1"
                          HorizontalScrollBarVisibility="Disabled"
                          HorizontalScrollMode="Disabled"
                          VerticalScrollBarVisibility="Hidden"
                          VerticalScrollMode="Enabled">
                <Grid>
            <ItemsRepeater x:Name="ItemsRepeater_List_5"
                           ItemsSource="{x:Bind WarpTypeStats.List_5}">
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="local:GachaLogItemEx">
                        <Grid Name="Grid_Rarity5Item"
                              Height="28"
                              Background="Transparent"
                              PointerEntered="Grid_Rarity5Item_PointerEntered"
                              PointerExited="Grid_Rarity5Item_PointerExited"
                              Tag="{x:Bind}"
                              ToolTipService.ToolTip="{x:Bind Time.ToString('yyyy-MM-dd HH:mm:ss', x:Null)}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" MinWidth="20" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="PityBar"
                                    Grid.Column="1"
                                    Height="24"
                                    Margin="-4,0,-4,0"
                                    VerticalAlignment="Center"
                                    Background="{x:Bind Converter={StaticResource GachaPityProgressBackgroundBrushConverter}}"
                                    CornerRadius="4" />
                            <sc:CachedImage Width="28"
                                            Height="28"
                                            DecodeWidth="28"
                                            DecodeHeight="28"
                                            HorizontalAlignment="Left"
                                            Source="{x:Bind Icon}" />
                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Text="{x:Bind Name}"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="{x:Bind IsPointerIn, Converter={StaticResource BoolToVisibilityReversedConverter}}" />
                            <TextBlock Grid.Column="3"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       IsTextScaleFactorEnabled="False"
                                       Text="{x:Bind Pity}"
                                       Visibility="{x:Bind IsPointerIn, Converter={StaticResource BoolToVisibilityReversedConverter}}" />
                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource Rarity5ForegroundBrush}"
                                       Text="{x:Bind Name}"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="{x:Bind IsPointerIn, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <TextBlock Grid.Column="3"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource Rarity5ForegroundBrush}"
                                       IsTextScaleFactorEnabled="False"
                                       Text="{x:Bind Pity}"
                                       Visibility="{x:Bind IsPointerIn, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <TextBlock Grid.Column="2"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       FontStyle="Italic"
                                       Foreground="{ThemeResource Rarity5ForegroundBrush}"
                                       IsTextScaleFactorEnabled="False"
                                       Opacity="{x:Bind UpTextOpacity}"
                                       Text="up!"
                                       Visibility="{x:Bind HasUpItem, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </Grid>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <ItemsRepeater x:Name="ItemsRepeater_List_4"
                           ItemsSource="{x:Bind WarpTypeStats.List_4}">
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="local:GachaLogItemEx">
                        <Grid Name="Grid_Rarity4Item"
                              Height="28"
                              Background="Transparent"
                              ColumnSpacing="8"
                              PointerEntered="Grid_Rarity4Item_PointerEntered"
                              PointerExited="Grid_Rarity4Item_PointerExited"
                              Tag="{x:Bind}"
                              ToolTipService.ToolTip="{x:Bind Time.ToString('yyyy-MM-dd HH:mm:ss', x:Null)}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="24" />
                            </Grid.ColumnDefinitions>
                            <sc:CachedImage Width="28"
                                            Height="28"
                                            DecodeWidth="28"
                                            DecodeHeight="28"
                                            Source="{x:Bind Icon}" />
                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Text="{x:Bind Name}"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="{x:Bind IsPointerIn, Converter={StaticResource BoolToVisibilityReversedConverter}}" />
                            <TextBlock Grid.Column="2"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Text="{x:Bind Pity}"
                                       Visibility="{x:Bind IsPointerIn, Converter={StaticResource BoolToVisibilityReversedConverter}}" />
                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource Rarity4ForegroundBrush}"
                                       Text="{x:Bind Name}"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="{x:Bind IsPointerIn, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <TextBlock Grid.Column="2"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource Rarity4ForegroundBrush}"
                                       Text="{x:Bind Pity}"
                                       Visibility="{x:Bind IsPointerIn, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </Grid>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
                </Grid>
            </ScrollViewer>
        </Grid>


    </Grid>

</UserControl>
