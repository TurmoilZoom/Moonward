<?xml version="1.0" encoding="utf-8" ?>
<!--
  自定义功能栏对话框里的一行：拖动柄 + 图标 + 名称（可带「仅某些区服」说明）+ 显示开关。
  整行可按住拖动排序（RightToolbarRowDragReorder），开关上的按下不起拖。
  拖动中整行换成不透明的浮层底色，压在其他行上面时不透字。
-->
<UserControl x:Class="Starward.Features.GameLauncher.RightToolbarCustomizeRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sh="using:Starward.Helpers"
             mc:Ignorable="d">

    <Grid x:Name="Grid_Root"
          Height="48"
          Padding="8,0,8,0"
          Background="Transparent"
          BorderBrush="Transparent"
          BorderThickness="1"
          ColumnSpacing="12"
          CornerRadius="6"
          PointerEntered="Grid_Root_PointerEntered"
          PointerExited="Grid_Root_PointerExited">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!--  拖动区：手形光标只罩住柄、图标和文字，开关保持默认光标  -->
        <Grid Grid.ColumnSpan="3"
              Margin="-8,0,0,0"
              sh:PointerCursor.CursorShape="Hand"
              Background="Transparent" />

        <FontIcon VerticalAlignment="Center"
                  FontSize="14"
                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                  Glyph="&#xE76F;"
                  IsHitTestVisible="False" />

        <Border x:Name="Border_Icon"
                Grid.Column="1"
                Width="32"
                Height="32"
                IsHitTestVisible="False" />

        <StackPanel Grid.Column="2"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False"
                    Spacing="2">
            <TextBlock x:Name="TextBlock_Title" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="TextBlock_Subtitle"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       TextTrimming="CharacterEllipsis"
                       Visibility="Collapsed" />
        </StackPanel>

        <!--  模板在开关与内容之间写死 12 宽的列，内容为空也照留：右边收回 12，焦点框跟着收  -->
        <ToggleSwitch x:Name="ToggleSwitch_Shown"
                      Grid.Column="3"
                      MinWidth="0"
                      Margin="0,0,-12,0"
                      VerticalAlignment="Center"
                      FocusVisualMargin="-7,-3,5,-3"
                      Loaded="ToggleSwitch_Shown_Loaded"
                      OffContent=""
                      OnContent=""
                      Toggled="ToggleSwitch_Shown_Toggled" />
    </Grid>

</UserControl>
