<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog x:Class="Starward.Features.GameLauncher.RightToolbarCustomizeDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:lang="using:Starward.Language"
               xmlns:local="using:Starward.Features.GameLauncher"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               x:DefaultBindMode="OneWay"
               Background="{ThemeResource CustomAcrylicBrush}"
               BorderThickness="0"
               CornerRadius="8"
               Style="{ThemeResource DefaultContentDialogStyle}"
               mc:Ignorable="d">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">1200</x:Double>
        <Thickness x:Key="ContentDialogPadding">0</Thickness>
        <!--  模板里空的 Title 行仍带 0,0,0,12 的下边距，不清零的话顶部会比左右多空 12（同便笺提醒对话框）  -->
        <Thickness x:Key="ContentDialogTitleMargin">0</Thickness>
        <StaticResource x:Key="ContentDialogSmokeFill" ResourceKey="ControlFillColorTransparentBrush" />
        <StaticResource x:Key="ContentDialogTopOverlay" ResourceKey="ControlFillColorTransparentBrush" />
    </ContentDialog.Resources>

    <!--
      外框宽 640，Padding 24 后内容区宽 592。
      自上而下：标题行（标题 + 关闭）→ 主体（左：游戏；右：该游戏的功能项）→ 底栏（说明 + 恢复默认）。
      主体固定高度，按功能项最多的游戏（6 行）算，切换游戏时对话框不跳动。
      改动即时保存并通知首页重排，没有确定按钮。
    -->
    <Grid Width="640" Padding="24,24,24,20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  标题行：负边距把整行上移 16、右伸 16，关闭按钮贴到右上角，标题仍与下方内容左缘对齐  -->
        <Grid Height="32"
              Margin="0,-16,-16,16"
              ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center"
                       FontSize="20"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="{x:Bind lang:Lang.RightToolbarCustomize_Title}"
                       TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="1"
                    Width="32"
                    Height="32"
                    Padding="0"
                    VerticalAlignment="Center"
                    BorderThickness="0"
                    Click="Button_Close_Click"
                    CornerRadius="8"
                    Style="{ThemeResource DateTimePickerFlyoutButtonStyle}">
                <FontIcon FontSize="16"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          Glyph="&#xE711;"
                          IsTextScaleFactorEnabled="False" />
            </Button>
        </Grid>


        <!--  主体：6 行 × 48 + 5 × 2 间距 + 卡片内边距 4 × 2 + 描边 1 × 2 = 308  -->
        <Grid Grid.Row="1"
              Height="308"
              ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  游戏列表  -->
            <Border Padding="0,4"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <ListView x:Name="ListView_Games"
                              ItemsSource="{x:Bind Games}"
                              SelectionChanged="ListView_Games_SelectionChanged"
                              SelectionMode="Single">
                        <ListView.Resources>
                            <!--  自带的选中指示条只会在新项上直接出现，换成下面叠加的滑动指示条  -->
                            <x:Boolean x:Key="ListViewItemSelectionIndicatorVisualEnabled">False</x:Boolean>
                        </ListView.Resources>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:RightToolbarGameView">
                                <Grid Height="44" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="28"
                                            Height="28"
                                            VerticalAlignment="Center"
                                            CornerRadius="6">
                                        <Image Source="{x:Bind Icon}" Stretch="UniformToFill" />
                                    </Border>
                                    <TextBlock Grid.Column="1"
                                               VerticalAlignment="Center"
                                               Text="{x:Bind Name}"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!--
                      滑动选中指示条（ListViewSlidingIndicator 驱动）：宿主与列表同位置同大小、负责裁剪；
                      中间一层跟随列表滚动；指示条尺寸与颜色同自带指示条（宽 3、高 16、强调色）。
                    -->
                    <Grid x:Name="Grid_GameIndicatorHost" IsHitTestVisible="False">
                        <Grid x:Name="Grid_GameIndicatorFollower">
                            <Border x:Name="Border_GameIndicator"
                                    Width="3"
                                    Height="16"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Background="{ThemeResource ListViewItemSelectionIndicatorBrush}"
                                    CornerRadius="1.5" />
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <!--  所选游戏的功能项：各行由代码创建（拖动排序要直接管理面板子元素）  -->
            <Border Grid.Column="1"
                    Padding="4"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel x:Name="StackPanel_Items" Spacing="2" />
            </Border>
        </Grid>


        <!--  底栏：说明 + 恢复默认（只重置当前选中的游戏）  -->
        <Grid Grid.Row="2"
              Margin="0,16,0,0"
              ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  图标与文字都顶对齐，文字折行时图标仍对着第一行  -->
            <Grid VerticalAlignment="Center" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon Margin="0,1,0,0"
                          VerticalAlignment="Top"
                          FontSize="14"
                          Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                          Glyph="&#xE946;" />
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Top"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           Text="{x:Bind lang:Lang.RightToolbarCustomize_Hint}"
                           TextWrapping="Wrap" />
            </Grid>

            <Button x:Name="Button_Reset"
                    Grid.Column="1"
                    Height="36"
                    Padding="16,0"
                    VerticalAlignment="Center"
                    BorderThickness="0"
                    Click="Button_Reset_Click"
                    CornerRadius="8"
                    IsEnabled="False">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE7A7;" />
                    <TextBlock Text="{x:Bind lang:Lang.Common_RestoreDefaults}" />
                </StackPanel>
            </Button>
        </Grid>

    </Grid>

</ContentDialog>
