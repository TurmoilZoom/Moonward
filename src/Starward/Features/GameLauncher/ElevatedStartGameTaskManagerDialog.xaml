<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog x:Class="Starward.Features.GameLauncher.ElevatedStartGameTaskManagerDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:lang="using:Starward.Language"
               xmlns:local="using:Starward.Features.GameLauncher"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               xmlns:sc="using:Starward.Controls"
               x:DefaultBindMode="OneWay"
               Background="{ThemeResource CustomAcrylicBrush}"
               BorderThickness="0"
               CornerRadius="8"
               Style="{ThemeResource DefaultContentDialogStyle}"
               mc:Ignorable="d">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">1200</x:Double>
        <Thickness x:Key="ContentDialogPadding">0</Thickness>
        <StaticResource x:Key="ContentDialogSmokeFill" ResourceKey="ControlFillColorTransparentBrush" />
        <StaticResource x:Key="ContentDialogTopOverlay" ResourceKey="ControlFillColorTransparentBrush" />
    </ContentDialog.Resources>


    <!--  尺寸固定：任务多少、反馈条开合都不改变对话框大小，只有列表区自身滚动  -->
    <Grid Width="560" Height="520">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  删除确认气泡：单项删除与「删除所选」共用，代码里 ShowAt 到对应按钮；挂在根节点只为取得命名作用域  -->
        <FlyoutBase.AttachedFlyout>
            <Flyout x:Name="Flyout_ConfirmDelete" Placement="Top">
                <StackPanel MaxWidth="280" Spacing="12">
                    <TextBlock Text="{x:Bind ConfirmationText}" TextWrapping="Wrap" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                        <Button Click="Button_CancelDelete_Click" Content="{x:Bind lang:Lang.Common_Cancel}" />
                        <Button Click="Button_ConfirmDelete_Click"
                                Content="{x:Bind lang:Lang.Common_Delete}"
                                Style="{ThemeResource AccentButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Flyout>
        </FlyoutBase.AttachedFlyout>

        <!--  标题：说明文字紧贴标题下方作副标题，不再占据整块正文  -->
        <StackPanel Margin="24,20,24,12" Spacing="4">
            <TextBlock FontSize="20"
                       FontWeight="Bold"
                       Text="{x:Bind lang:Lang.StartGameTaskManager_Title}" />
            <TextBlock FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="{x:Bind lang:Lang.StartGameTaskManager_Description}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <MenuFlyoutSeparator Grid.Row="1" Margin="24,0,24,0" />

        <!--  任务列表 / 空态 / 载入中  -->
        <Grid Grid.Row="2">

            <!--  右侧留 14px 装订线，滚动条不压住删除按钮  -->
            <ScrollViewer Padding="24,12,14,12"
                          IsEnabled="{x:Bind CanEdit}"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="{x:Bind HasTasks, Converter={StaticResource BoolToVisibilityConverter}}">
                <ItemsControl ItemsSource="{x:Bind TaskGroups}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="16" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:ElevatedStartGameTaskGroup">
                            <StackPanel Spacing="6">
                                <!--  分组标题：游戏图标 + 游戏名 + 区服名，与游戏选择器一致  -->
                                <StackPanel Margin="2,0,0,0" Orientation="Horizontal" Spacing="8">
                                    <Border Width="20"
                                            Height="20"
                                            VerticalAlignment="Center"
                                            CornerRadius="4"
                                            Visibility="{x:Bind GameIcon, Converter={StaticResource ObjectToVisibilityConverter}}">
                                        <Image Source="{x:Bind GameIcon}" Stretch="UniformToFill" />
                                    </Border>
                                    <TextBlock VerticalAlignment="Center"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Text="{x:Bind GameName}" />
                                    <TextBlock VerticalAlignment="Center"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               Text="{x:Bind ServerName}" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{x:Bind Tasks}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="4" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="local:ElevatedStartGameTaskItem">
                                            <!--  一行一个任务：勾选框贴左、配置名撑开中段、UID 与删除按钮靠右；悬停显示计划任务路径  -->
                                            <Grid Padding="10,6,6,6"
                                                  Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                  ColumnSpacing="10"
                                                  CornerRadius="6"
                                                  sc:InstantTooltip.Placement="Top"
                                                  sc:InstantTooltip.Text="{x:Bind TaskPath}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox MinWidth="0"
                                                          MinHeight="0"
                                                          Padding="0"
                                                          VerticalAlignment="Center"
                                                          VerticalContentAlignment="Center"
                                                          IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                          Style="{ThemeResource CompactCheckBoxStyle}" />
                                                <TextBlock Grid.Column="1"
                                                           VerticalAlignment="Center"
                                                           Text="{x:Bind ProfileText}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="2"
                                                           VerticalAlignment="Center"
                                                           FontSize="12"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           Text="{x:Bind LoginUidText}"
                                                           Visibility="{x:Bind LoginUidText, Converter={StaticResource ObjectToVisibilityConverter}}" />
                                                <Button Grid.Column="3"
                                                        Width="32"
                                                        Height="32"
                                                        Padding="0"
                                                        VerticalAlignment="Center"
                                                        Click="Button_DeleteTask_Click"
                                                        Style="{ThemeResource DateTimePickerFlyoutButtonStyle}"
                                                        sc:InstantTooltip.Placement="Top"
                                                        sc:InstantTooltip.Text="{x:Bind lang:Lang.Common_Delete}">
                                                    <FontIcon FontSize="16"
                                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                              Glyph="&#xE74D;" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!--  空态  -->
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12"
                        Visibility="{x:Bind ShowEmptyState, Converter={StaticResource BoolToVisibilityConverter}}">
                <FontIcon HorizontalAlignment="Center"
                          FontSize="28"
                          Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                          Glyph="&#xE946;" />
                <TextBlock MaxWidth="320"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="{x:Bind lang:Lang.StartGameTaskManager_NoTasks}"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
            </StackPanel>

            <ProgressRing Width="28"
                          Height="28"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          IsActive="True"
                          Visibility="{x:Bind IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
        </Grid>

        <!--  操作反馈  -->
        <InfoBar x:Name="InfoBar_Feedback"
                 Grid.Row="3"
                 Margin="24,0,24,0"
                 IsClosable="True"
                 IsOpen="False" />

        <!--  底部：左侧三态全选，右侧删除所选与关闭  -->
        <Grid Grid.Row="4" Padding="24,16,24,20" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <CheckBox MinWidth="0"
                      MinHeight="0"
                      Padding="10,0,0,0"
                      VerticalAlignment="Center"
                      VerticalContentAlignment="Center"
                      Click="CheckBox_SelectAll_Click"
                      Content="{x:Bind lang:Lang.Common_SelectAll}"
                      IsChecked="{x:Bind AllSelected}"
                      IsEnabled="{x:Bind CanEdit}"
                      IsThreeState="True"
                      Style="{ThemeResource CompactCheckBoxStyle}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                <Button MinWidth="100"
                        Click="Button_DeleteSelected_Click"
                        Content="{x:Bind DeleteSelectedText}"
                        IsEnabled="{x:Bind CanDeleteSelected}" />
                <Button MinWidth="100"
                        Click="Button_Close_Click"
                        Content="{x:Bind lang:Lang.Common_Cancel}"
                        IsEnabled="{x:Bind CanClose}"
                        Style="{ThemeResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>

    </Grid>

</ContentDialog>
