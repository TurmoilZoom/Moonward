<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog x:Class="Starward.Features.GameLauncher.GameLaunchProfileDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:dev="using:DevWin"
               xmlns:lang="using:Starward.Language"
               xmlns:local="using:Starward.Features.GameLauncher"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               xmlns:sc="using:Starward.Controls"
               x:DefaultBindMode="OneWay"
               Background="{ThemeResource CustomAcrylicBrush}"
               BorderThickness="0"
               CornerRadius="8"
               Style="{ThemeResource DefaultContentDialogStyle}"
               mc:Ignorable="d">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">1200</x:Double>
        <Thickness x:Key="ContentDialogPadding">0</Thickness>
        <!--  模板里空的 Title 行仍带 0,0,0,12 的下边距，不清零的话顶部会比左右多空 12（同好感壁纸对话框）  -->
        <Thickness x:Key="ContentDialogTitleMargin">0</Thickness>
        <StaticResource x:Key="ContentDialogSmokeFill" ResourceKey="ControlFillColorTransparentBrush" />
        <StaticResource x:Key="ContentDialogTopOverlay" ResourceKey="ControlFillColorTransparentBrush" />
    </ContentDialog.Resources>

    <!--
      外框宽 600（与游戏设置对话框一致），Padding 24 后内容区宽 552。
      自上而下：标题行（标题 + 关闭）→ 配置文件栏（选哪个）→ 表单（按配置文件保存；分隔线下为全局 CMD）→ 底栏（URL 指令 + 保存）。
      对齐按「看得见的内容」：链接按钮、复制按钮用负边距抵掉自身内边距，让文字 / 图标贴齐内容区边缘。
      表单行用 *：ContentDialog 给内容的是有限高度，放得下时随内容高，窗口放不下时才滚动。
    -->
    <Grid Width="600"
          Padding="24,24,24,20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
          标题行（同好感壁纸对话框）：标题与关闭按钮同一行。
          负边距把整行上移 16、右伸 16：关闭按钮贴到距边框 8 的右上角，标题仍与下方内容左缘对齐。
        -->
        <Grid Height="32"
              Margin="0,-16,-16,16"
              ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center"
                       FontSize="20"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="{x:Bind lang:Lang.GameLaunchProfileWindow_Title}"
                       TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="1"
                    Width="32"
                    Height="32"
                    Padding="0"
                    VerticalAlignment="Center"
                    BorderThickness="0"
                    Command="{x:Bind CloseCommand}"
                    CornerRadius="8"
                    Style="{ThemeResource DateTimePickerFlyoutButtonStyle}">
                <FontIcon FontSize="16"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          Glyph="&#xE711;"
                          IsTextScaleFactorEnabled="False" />
            </Button>
        </Grid>

        <!--  配置文件栏：下拉框与重命名输入框同位切换 + 新建 + 更多（重命名 / 删除）  -->
        <!--  「放弃未保存更改」挂在整栏上：重命名时下拉框已折叠，挂在下拉框上弹不出来  -->
        <Grid x:Name="Grid_ProfileBar"
              Grid.Row="1"
              Margin="0,0,0,20"
              ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FlyoutBase.AttachedFlyout>
                <Flyout>
                    <StackPanel MaxWidth="260" Spacing="12">
                        <TextBlock Text="{x:Bind lang:Lang.GameLauncherSettingDialog_DiscardUnsavedProfileChanges}" TextWrapping="Wrap" />
                        <StackPanel HorizontalAlignment="Right"
                                    Orientation="Horizontal"
                                    Spacing="8">
                            <Button Click="DiscardProfileChanges_Cancel_Click" Content="{x:Bind lang:Lang.Common_Cancel}" />
                            <Button Click="DiscardProfileChanges_Confirm_Click"
                                    Content="{x:Bind lang:Lang.Common_Confirm}"
                                    Style="{ThemeResource AccentButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Flyout>
            </FlyoutBase.AttachedFlyout>

            <ComboBox x:Name="ComboBox_LaunchProfile"
                      Height="36"
                      HorizontalAlignment="Stretch"
                      BorderThickness="0"
                      CornerRadius="8"
                      DisplayMemberPath="Name"
                      ItemsSource="{x:Bind Profiles}"
                      SelectedItem="{x:Bind SelectedProfile, Mode=OneWay}"
                      SelectionChanged="ComboBox_LaunchProfile_SelectionChanged"
                      Visibility="{x:Bind ProfileSelectorVisibility, Mode=OneWay}" />
            <!--  重命名：Enter 保存、Esc 取消（PreviewKeyDown 先于对话框拦截 Esc，避免直接关掉对话框）  -->
            <TextBox x:Name="TextBox_ProfileName"
                     MinHeight="36"
                     Padding="10,8,6,8"
                     HorizontalAlignment="Stretch"
                     HorizontalTextAlignment="Left"
                     IsSpellCheckEnabled="False"
                     PreviewKeyDown="TextBox_ProfileName_PreviewKeyDown"
                     VerticalContentAlignment="Center"
                     Text="{x:Bind EditingName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Visibility="{x:Bind RenameAreaVisibility, Mode=OneWay}" />
            <!--  新建配置文件；悬停用 InstantTooltip（亚克力气泡，非系统 ToolTip）  -->
            <Button Grid.Column="1"
                    Width="36"
                    Height="36"
                    Padding="0"
                    Command="{x:Bind NewProfileCommand}"
                    CornerRadius="8"
                    IsEnabled="{x:Bind CanCreateProfile, Mode=OneWay}"
                    sc:InstantTooltip.Placement="Top"
                    sc:InstantTooltip.Text="{x:Bind lang:Lang.GameLauncherSettingDialog_NewProfile}"
                    Style="{ThemeResource DateTimePickerFlyoutButtonStyle}">
                <FontIcon FontSize="16"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          Glyph="&#xE710;" />
            </Button>
            <!--  更多：重命名 / 删除（低频操作收进菜单）；删除确认 Flyout 挂在同一按钮上，菜单关闭后再弹  -->
            <Button x:Name="Button_ProfileMore"
                    Grid.Column="2"
                    Width="36"
                    Height="36"
                    Padding="0"
                    CornerRadius="8"
                    sc:InstantTooltip.Placement="Top"
                    sc:InstantTooltip.Text="{x:Bind lang:Lang.Common_More}"
                    Style="{ThemeResource DateTimePickerFlyoutButtonStyle}">
                <FontIcon FontSize="16"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          Glyph="&#xE712;" />
                <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuFlyoutItem Command="{x:Bind ShowRenameProfileCommand}" Text="{x:Bind lang:Lang.ImageBatchConvertWindow_Rename}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE70F;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Click="MenuFlyoutItem_DeleteProfile_Click"
                                        IsEnabled="{x:Bind CanDeleteProfile, Mode=OneWay}"
                                        Text="{x:Bind lang:Lang.Common_Delete}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE74D;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>
                <FlyoutBase.AttachedFlyout>
                    <Flyout Placement="BottomEdgeAlignedRight">
                        <StackPanel MaxWidth="260" Spacing="12">
                            <TextBlock TextWrapping="Wrap"><Run Text="{x:Bind lang:Lang.Common_Delete}" /><Run Text="  " /><Run Text="{x:Bind SelectedProfileName, Mode=OneWay}" /></TextBlock>
                            <StackPanel HorizontalAlignment="Right"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                <Button Click="DeleteProfile_Cancel_Click" Content="{x:Bind lang:Lang.Common_Cancel}" />
                                <Button Click="DeleteProfile_Confirm_Click">
                                    <TextBlock Foreground="{ThemeResource SystemFillColorCriticalBrush}" Text="{x:Bind lang:Lang.Common_Delete}" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Flyout>
                </FlyoutBase.AttachedFlyout>
            </Button>
        </Grid>

        <!--
          视口四周比内容多出 8/4（ScrollViewer 负边距 + 内容等量正边距，布局不变）：
          ScrollViewer 会裁掉超出视口的部分，不留余量的话链接按钮负边距后的悬停底色、边缘控件的焦点框都会被切掉。
        -->
        <ScrollViewer Grid.Row="2"
                      Margin="-8,-4,-8,-4"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <!--  标签在上、控件占满整行：左缘统一，长文案语言也不必给标签列限宽  -->
            <StackPanel Margin="8,4,8,4" Spacing="16">

                <!--  登录账号（国服；列表同源米游社工具箱角色）  -->
                <StackPanel Spacing="8" Visibility="{x:Bind LoginAccountVisibility, Mode=OneWay}">
                    <TextBlock Text="{x:Bind lang:Lang.GameLauncherSettingDialog_LoginAccount}" TextWrapping="Wrap" />
                    <ComboBox Height="36"
                              HorizontalAlignment="Stretch"
                              BorderThickness="0"
                              CornerRadius="8"
                              DisplayMemberPath="DisplayName"
                              ItemsSource="{x:Bind LoginAccountOptions}"
                              SelectedItem="{x:Bind SelectedLoginAccountOption, Mode=TwoWay}" />
                </StackPanel>

                <!--  命令行参数：标题行右侧打开常用参数面板；DX12 自动附加的参数在输入框下方说明  -->
                <StackPanel Spacing="8">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   Text="{x:Bind lang:Lang.GameLauncherSettingDialog_CommandLineArgument}"
                                   TextWrapping="Wrap" />
                        <!--  用 Popup 整窗居中 + 点空白关闭，见 Click；右负边距 = 内边距 6 + 边框 1，文字右缘对齐输入框  -->
                        <HyperlinkButton Grid.Column="1"
                                         Margin="0,0,-7,0"
                                         Padding="6,2"
                                         VerticalAlignment="Center"
                                         Click="Button_CommandLineArgumentPicker_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="14" Glyph="&#xE8FD;" />
                                <TextBlock Text="{x:Bind lang:Lang.CmdArg_PickerButtonTooltip}" />
                            </StackPanel>
                        </HyperlinkButton>
                    </Grid>
                    <!--  保持单行（默认 NoWrap），以显示 WinUI 自带清除按钮  -->
                    <TextBox MinHeight="36"
                             Padding="10,8,6,8"
                             HorizontalTextAlignment="Left"
                             IsSpellCheckEnabled="False"
                             VerticalContentAlignment="Center"
                             Text="{x:Bind EditingArgument, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <!--  DX12 自动附加参数：全局开启且本配置未关闭时显示；「本配置不附加」只作用于当前配置文件  -->
                    <Grid ColumnSpacing="8" Visibility="{x:Bind Dx12ArgumentVisibility, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Padding="6,1,6,2"
                                VerticalAlignment="Center"
                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                CornerRadius="4">
                            <TextBlock FontFamily="Consolas"
                                       FontSize="12"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                       Text="-use-d3d12" />
                        </Border>
                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="{x:Bind lang:Lang.GameLaunchProfileDialog_Dx12ArgumentAutoAppended}"
                                   TextWrapping="Wrap" />
                        <!--  右负边距 = 内边距 4 + 边框 1，文字右缘对齐输入框  -->
                        <HyperlinkButton Grid.Column="2"
                                         Margin="0,0,-5,0"
                                         Padding="4,1"
                                         VerticalAlignment="Center"
                                         Click="DismissDx12Argument_Click"
                                         FontSize="12"
                                         sc:InstantTooltip.Placement="Top"
                                         sc:InstantTooltip.Text="{x:Bind lang:Lang.GameLaunchProfileDialog_DismissDx12ArgumentTooltip}">
                            <TextBlock Text="{x:Bind lang:Lang.GameLaunchProfileDialog_DismissDx12Argument}" />
                        </HyperlinkButton>
                    </Grid>
                </StackPanel>

                <!--  自定义启动程序：未设置时显示说明，设置后为路径条（点击打开所在文件夹、× 清除），同游戏设置「安装位置」  -->
                <StackPanel Spacing="8">
                    <TextBlock Text="{x:Bind lang:Lang.LauncherPage_CustomStartExecutable}" TextWrapping="Wrap" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border MinHeight="36"
                                Padding="12,6"
                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                CornerRadius="8"
                                Visibility="{x:Bind ThirdPartyToolHintVisibility, Mode=OneWay}">
                            <TextBlock VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       MaxLines="2"
                                       Text="{x:Bind lang:Lang.GameLauncherSettingDialog_ThirdPartyToolTip}"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="Wrap" />
                        </Border>
                        <Grid MinHeight="36"
                              CornerRadius="8"
                              Visibility="{x:Bind ThirdPartyToolPathVisibility, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!--  打开自定义启动程序所在文件夹  -->
                            <Button Padding="12,0,8,1"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    BorderThickness="0"
                                    Command="{x:Bind OpenThirdPartyToolFolderCommand}"
                                    CornerRadius="0">
                                <TextBlock VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           IsTextTrimmedChanged="TextBlock_IsTextTrimmedChanged"
                                           MaxLines="2"
                                           Text="{x:Bind EditingThirdPartyToolPath, Mode=OneWay}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="Wrap" />
                            </Button>
                            <!--  清除自定义启动程序（保存后生效）  -->
                            <Button Grid.Column="1"
                                    Width="36"
                                    Padding="0"
                                    VerticalAlignment="Stretch"
                                    BorderThickness="0"
                                    Command="{x:Bind DeleteThirdPartyToolPathCommand}"
                                    CornerRadius="0">
                                <FontIcon FontSize="14"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          Glyph="&#xE711;" />
                            </Button>
                        </Grid>
                        <!--  开启 CMD 启动时禁用（两者互斥）  -->
                        <Button Grid.Column="1"
                                MinWidth="72"
                                Height="36"
                                VerticalAlignment="Top"
                                Command="{x:Bind ChangeThirdPartyPathCommand}"
                                Content="{x:Bind lang:Lang.Common_Select}"
                                CornerRadius="8"
                                IsEnabled="{x:Bind IsThirdPartyToolEnabled, Mode=OneWay}" />
                    </Grid>
                </StackPanel>

                <!--  全局设置（分隔线下，即时生效、不进配置文件）：使用 CMD 启动游戏，与自定义启动程序互斥  -->
                <Grid Padding="0,16,0,0"
                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                      BorderThickness="0,1,0,0"
                      ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{x:Bind lang:Lang.GameLauncherSettingDialog_LaunchGameUsingCMD}" TextWrapping="Wrap" />
                        <TextBlock FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap">
                            <Run Text="{x:Bind lang:Lang.GameLauncherSettingDialog_AvoidShowingAlertsAboutDetectingIllegalToolInTheGame}" />
                            <Hyperlink NavigateUri="https://github.com/Scighost/Starward/issues/1634" UnderlineStyle="None">#1634</Hyperlink>
                            <LineBreak />
                            <Run Text="{x:Bind lang:Lang.GameLaunchProfileDialog_CmdLaunchScopeHint}" />
                        </TextBlock>
                    </StackPanel>
                    <!--  On/Off 文案为空、标签外置；模板在开关右侧预留 12 的内容间距，负边距让开关右缘与上方控件对齐  -->
                    <ToggleSwitch Grid.Column="1"
                                  MinWidth="0"
                                  Margin="0,0,-12,0"
                                  VerticalAlignment="Center"
                                  IsEnabled="{x:Bind IsCmdToggleEnabled, Mode=OneWay}"
                                  IsOn="{x:Bind StartGameWithCMD, Mode=TwoWay}"
                                  OffContent="{x:Null}"
                                  OnContent="{x:Null}" />
                </Grid>

            </StackPanel>
        </ScrollViewer>

        <!--  底栏：左 URL 指令（复制按钮在前、文字过长时省略）+ 右「保存」  -->
        <Grid Grid.Row="3"
              Margin="0,20,0,0"
              ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!--  复制按钮放在文字前：URL 逐字显现时按钮位置不跟着移动  -->
            <Grid VerticalAlignment="Center" ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!--  左负边距 9 =（按钮 32 − 图标 14）/ 2，图标左缘对齐上方内容  -->
                <Button x:Name="Button_CopyProfileUrl"
                        Width="32"
                        Height="32"
                        Margin="-9,0,0,0"
                        Padding="0"
                        Click="Button_CopyProfileUrl_Click"
                        CornerRadius="8"
                        sc:InstantTooltip.Placement="Top"
                        sc:InstantTooltip.Text="{x:Bind lang:Lang.Common_Copy}"
                        Style="{ThemeResource DateTimePickerFlyoutButtonStyle}">
                    <FontIcon FontSize="14"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              Glyph="&#xE71B;" />
                </Button>
                <dev:AnimatedTextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       FontFamily="Consolas"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       Text="{x:Bind ProfileStartGameUrl, Mode=OneWay}" />
            </Grid>
            <!--  保存配置文件：有未保存改动时才可用  -->
            <Button Grid.Column="1"
                    MinWidth="96"
                    Height="36"
                    BorderThickness="0"
                    Command="{x:Bind SaveProfileCommand}"
                    CornerRadius="8"
                    IsEnabled="{x:Bind IsDirty, Mode=OneWay}"
                    Style="{ThemeResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="16" Glyph="&#xE74E;" />
                    <TextBlock Text="{x:Bind lang:Lang.Common_Save}" />
                </StackPanel>
            </Button>
        </Grid>

        <!--
          常用参数勾选内容模板：XAML 里的 Popup 不直接打开。
          首次点击时把 Child 挪到「仅 XamlRoot」的独立 Popup（见 EnsureCommandLineArgumentPickerPopup），
          铺满整窗 + 卡片布局居中，与 ContentDialog 同一参照（含导航栏/标题栏）。
          点空白关闭（系统 LightDismiss 在 Child 铺满时无效）。
          卡片比对话框窄（520 < 600）；定位层压暗，两侧露出的对话框退到背景里，不和卡片内容抢视线。
        -->
        <Popup x:Name="Popup_CommandLineArgumentPicker"
               IsLightDismissEnabled="False"
               Visibility="Collapsed">
            <Grid x:Name="Grid_CommandLineArgumentPickerRoot"
                  Background="{ThemeResource SmokeFillColorDefaultBrush}"
                  Tapped="Grid_CommandLineArgumentPickerRoot_Tapped">
                <Border x:Name="Border_CommandLineArgumentPickerHost"
                        MaxWidth="520"
                        MaxHeight="640"
                        Padding="16"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{ThemeResource CustomAcrylicBrush}"
                        CornerRadius="8"
                        Tapped="Border_CommandLineArgumentPickerHost_Tapped">
                    <local:GameCommandLineArgumentPicker x:Name="CommandLineArgumentPicker"
                                                         CombinedArgumentChanged="CommandLineArgumentPicker_CombinedArgumentChanged" />
                </Border>
            </Grid>
        </Popup>

    </Grid>

</ContentDialog>
