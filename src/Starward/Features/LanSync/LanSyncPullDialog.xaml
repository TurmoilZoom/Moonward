<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog x:Class="Starward.Features.LanSync.LanSyncPullDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:cwc="using:CommunityToolkit.WinUI.Controls"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:lang="using:Starward.Language"
               xmlns:local="using:Starward.Features.LanSync"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               xmlns:sc="using:Starward.Controls"
               xmlns:sh="using:Starward.Helpers"
               x:DefaultBindMode="OneWay"
               Background="{ThemeResource CustomAcrylicBrush}"
               BorderThickness="0"
               Closed="ContentDialog_Closed"
               Loaded="ContentDialog_Loaded"
               Style="{ThemeResource DefaultContentDialogStyle}"
               mc:Ignorable="d">

    <StackPanel Width="440" Spacing="12">
        <TextBlock FontSize="20"
                   Text="{x:Bind lang:Lang.LanSync_SyncFromOtherDevice}"
                   TextWrapping="Wrap" />
        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="{x:Bind lang:Lang.LanSync_SyncDialogDescription}"
                   TextWrapping="Wrap" />
        <TextBlock FontSize="12"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="{x:Bind ShareHintText}"
                   TextWrapping="Wrap" />

        <!--  局域网内的设备  -->
        <Grid Margin="0,4,0,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="{x:Bind lang:Lang.LanSync_Devices}" />
            <ProgressRing Grid.Column="1"
                          Width="16"
                          Height="16"
                          IsActive="{x:Bind IsSearching}"
                          Visibility="{x:Bind sh:BindConverter.BoolToVisibility(IsSearching)}" />
            <Button Grid.Column="2"
                    Width="32"
                    Height="32"
                    Padding="0"
                    Command="{x:Bind SearchCommand}"
                    IsEnabled="{x:Bind CanOperate}"
                    sc:InstantTooltip.Placement="Top"
                    sc:InstantTooltip.Text="{x:Bind lang:Lang.Common_Refresh}"
                    Style="{ThemeResource DateTimePickerFlyoutButtonStyle}">
                <FontIcon FontSize="14"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          Glyph="&#xE72C;" />
            </Button>
        </Grid>
        <ListView MaxHeight="168"
                  IsEnabled="{x:Bind CanOperate}"
                  ItemsSource="{x:Bind Peers}"
                  SelectedItem="{x:Bind SelectedPeer, Mode=TwoWay}"
                  SelectionMode="Single"
                  Visibility="{x:Bind sh:BindConverter.BoolToVisibility(HasPeers)}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:LanSyncPeer">
                    <StackPanel Padding="0,8" Spacing="2">
                        <TextBlock Text="{x:Bind DeviceName}" TextTrimming="CharacterEllipsis" />
                        <TextBlock FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="{x:Bind Description}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <TextBlock FontSize="12"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="{x:Bind lang:Lang.LanSync_NoDeviceFound}"
                   TextWrapping="Wrap"
                   Visibility="{x:Bind sh:BindConverter.BoolToVisibility(ShowNoDeviceHint)}" />

        <!--  手动地址 · 验证码  -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="140" />
            </Grid.ColumnDefinitions>
            <TextBox Header="{x:Bind lang:Lang.LanSync_ManualAddress}"
                     IsEnabled="{x:Bind CanOperate}"
                     PlaceholderText="{x:Bind lang:Lang.LanSync_ManualAddressPlaceholder}"
                     Text="{x:Bind ManualAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <!--  长度放宽到 7，允许粘贴共享端显示的「123 456」，提交时只取数字  -->
            <TextBox Grid.Column="1"
                     Header="{x:Bind lang:Lang.LanSync_VerificationCode}"
                     InputScope="Number"
                     IsEnabled="{x:Bind CanOperate}"
                     MaxLength="7"
                     PlaceholderText="{x:Bind lang:Lang.LanSync_CodePlaceholder}"
                     Text="{x:Bind Code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <!--  同步内容  -->
        <StackPanel Spacing="4">
            <TextBlock Text="{x:Bind lang:Lang.LanSync_DataToSync}" />
            <cwc:WrapPanel HorizontalSpacing="16" VerticalSpacing="0">
                <CheckBox Content="{x:Bind lang:Lang.LanSync_Category_Gacha}"
                          IsChecked="{x:Bind SyncGacha, Mode=TwoWay}"
                          IsEnabled="{x:Bind CanOperate}" />
                <CheckBox Content="{x:Bind lang:Lang.LanSync_Category_GameRecord}"
                          IsChecked="{x:Bind SyncGameRecord, Mode=TwoWay}"
                          IsEnabled="{x:Bind CanOperate}" />
                <CheckBox Content="{x:Bind lang:Lang.LanSync_Category_PlayTime}"
                          IsChecked="{x:Bind SyncPlayTime, Mode=TwoWay}"
                          IsEnabled="{x:Bind CanOperate}" />
            </cwc:WrapPanel>
        </StackPanel>

        <!--  进度与结果  -->
        <StackPanel Spacing="6" Visibility="{x:Bind sh:BindConverter.BoolToVisibility(IsSyncing)}">
            <ProgressBar IsIndeterminate="{x:Bind ProgressIsIndeterminate}"
                         Maximum="100"
                         Value="{x:Bind ProgressValue}" />
            <TextBlock FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="{x:Bind ProgressText}"
                       TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <TextBlock Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                   Text="{x:Bind ResultText}"
                   TextWrapping="Wrap"
                   Visibility="{x:Bind sh:BindConverter.ObjectToVisibility(ResultText)}" />
        <TextBlock Foreground="{ThemeResource SystemFillColorCautionBrush}"
                   Text="{x:Bind ErrorText}"
                   TextWrapping="Wrap"
                   Visibility="{x:Bind sh:BindConverter.ObjectToVisibility(ErrorText)}" />

        <StackPanel Margin="0,8,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="12">
            <Button MinWidth="100"
                    Command="{x:Bind SyncCommand}"
                    Content="{x:Bind lang:Lang.LanSync_Sync}"
                    IsEnabled="{x:Bind CanOperate}"
                    Style="{ThemeResource AccentButtonStyle}" />
            <Button MinWidth="100"
                    Click="Button_Close_Click"
                    Content="{x:Bind lang:Lang.Common_Close}" />
        </StackPanel>
    </StackPanel>

</ContentDialog>
