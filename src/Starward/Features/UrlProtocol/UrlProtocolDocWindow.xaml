<?xml version="1.0" encoding="utf-8" ?>
<sf:WindowEx x:Class="Starward.Features.UrlProtocol.UrlProtocolDocWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lang="using:Starward.Language"
             xmlns:local="using:Starward.Features.UrlProtocol"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sc="using:Starward.Controls"
             xmlns:sf="using:Starward.Frameworks"
             mc:Ignorable="d">

    <Grid x:Name="RootGrid" Loaded="RootGrid_Loaded">
        <!--  加载中 / 出错：顶部同样让出 32 标题栏，在文档内容区居中  -->
        <StackPanel x:Name="StackPanel_Loading"
                    Margin="0,32,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="24">
            <ProgressRing Width="32"
                          Height="32"
                          IsActive="True" />
        </StackPanel>

        <StackPanel x:Name="StackPanel_Error"
                    Margin="0,32,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="24"
                    Visibility="Collapsed">
            <TextBlock x:Name="TextBlock_Error"
                       HorizontalAlignment="Center"
                       FontSize="16"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />
            <!--  与发行说明窗口一致：重试按钮在错误文案下方居中，不随 StackPanel 默认靠左  -->
            <Button Height="36"
                    Padding="20,0,20,0"
                    HorizontalAlignment="Center"
                    BorderThickness="0"
                    Click="Button_Retry_Click"
                    CornerRadius="18">
                <TextBlock Margin="8,0,8,0"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="{x:Bind lang:Lang.DownloadGamePage_Retry}" />
            </Button>
        </StackPanel>

        <!--  文档本地渲染；顶部 32 留给标题栏  -->
        <ScrollViewer x:Name="Scroller_Document"
                      Margin="0,32,0,0"
                      HorizontalScrollBarVisibility="Disabled"
                      HorizontalScrollMode="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      Visibility="Collapsed">
            <sc:MarkdownView x:Name="MarkdownView_Document" Margin="24,0,24,24" />
        </ScrollViewer>
    </Grid>

</sf:WindowEx>