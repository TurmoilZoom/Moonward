<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog x:Class="Starward.Features.GameRecord.CaptchaLoginDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:lang="using:Starward.Language"
               xmlns:local="using:Starward.Features.GameRecord"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               Title="{x:Bind lang:Lang.HoyolabToolboxPage_CaptchaLogin}"
               Background="{ThemeResource CustomAcrylicBrush}"
               BorderThickness="0"
               CornerRadius="8"
               Style="{ThemeResource DefaultContentDialogStyle}"
               mc:Ignorable="d">

    <!--  取消系统默认按钮区，按钮放在表单内，与亚克力背景一体  -->
    <ContentDialog.Resources>
        <Thickness x:Key="ContentDialogPadding">20</Thickness>
        <x:Double x:Key="ContentDialogMinWidth">360</x:Double>
        <StaticResource x:Key="ContentDialogSmokeFill" ResourceKey="ControlFillColorTransparentBrush" />
        <StaticResource x:Key="ContentDialogTopOverlay" ResourceKey="ControlFillColorTransparentBrush" />
    </ContentDialog.Resources>

    <StackPanel MinWidth="320" Spacing="10">
        <StackPanel Spacing="4">
            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="{x:Bind lang:Lang.CaptchaLogin_PhoneNumber}" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           MinWidth="36"
                           VerticalAlignment="Center"
                           FontSize="14"
                           Text="+86" />
                <TextBox x:Name="TextBox_Phone"
                         Grid.Column="1"
                         IsSpellCheckEnabled="False"
                         MaxLength="11"
                         InputScope="TelephoneNumber" />
            </Grid>
        </StackPanel>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TextBox_Code"
                     Grid.Column="0"
                     Header="{x:Bind lang:Lang.CaptchaLogin_Code}"
                     IsSpellCheckEnabled="False"
                     MaxLength="8" />
            <Button x:Name="Button_SendCode"
                    Grid.Column="1"
                    MinWidth="108"
                    Margin="0,22,0,0"
                    VerticalAlignment="Bottom"
                    Click="Button_SendCode_Click"
                    Content="{x:Bind lang:Lang.CaptchaLogin_SendCode}" />
        </Grid>

        <ProgressBar x:Name="ProgressBar_Loading"
                     IsIndeterminate="True"
                     Visibility="Collapsed" />

        <!--  对话框打开期间的提示放在框内，避免主窗口 Toast 被模态层挡住无法关闭  -->
        <InfoBar x:Name="InfoBar_Feedback"
                 IsClosable="True"
                 IsOpen="False" />

        <!--  登录 / 取消：紧挨验证码输入，统一落在同一亚克力对话框内  -->
        <Grid Margin="0,4,0,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="Button_Cancel"
                    Grid.Column="1"
                    MinWidth="88"
                    Click="Button_Cancel_Click"
                    Content="{x:Bind lang:Lang.Common_Cancel}" />
            <Button x:Name="Button_Login"
                    Grid.Column="2"
                    MinWidth="88"
                    Click="Button_Login_Click"
                    Content="{x:Bind lang:Lang.CaptchaLogin_Login}"
                    Style="{ThemeResource AccentButtonStyle}" />
        </Grid>
    </StackPanel>
</ContentDialog>
