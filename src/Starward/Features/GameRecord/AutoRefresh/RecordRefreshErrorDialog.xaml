<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog x:Class="Starward.Features.GameRecord.AutoRefresh.RecordRefreshErrorDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:lang="using:Starward.Language"
               xmlns:local="using:Starward.Features.GameRecord.AutoRefresh"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               x:DefaultBindMode="OneWay"
               Background="{ThemeResource CustomAcrylicBrush}"
               BorderThickness="0"
               CornerRadius="8"
               Style="{ThemeResource DefaultContentDialogStyle}"
               mc:Ignorable="d">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">1200</x:Double>
        <Thickness x:Key="ContentDialogPadding">0</Thickness>
        <StaticResource x:Key="ContentDialogSmokeFill" ResourceKey="ControlFillColorTransparentBrush" />
        <StaticResource x:Key="ContentDialogTopOverlay" ResourceKey="ControlFillColorTransparentBrush" />
    </ContentDialog.Resources>


    <!--  尺寸固定：记录多少条都不改变对话框大小，只有列表区自身滚动  -->
    <Grid Width="560" Height="480">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>


        <StackPanel Margin="24,20,24,12" Spacing="4">
            <TextBlock FontSize="20"
                       FontWeight="Bold"
                       Text="{x:Bind lang:Lang.AutoRecordRefresh_Errors}" />
            <TextBlock FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="{x:Bind lang:Lang.AutoRecordRefresh_ErrorsDescription}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <MenuFlyoutSeparator Grid.Row="1" Margin="24,0,24,0" />

        <Grid Grid.Row="2">
            <!--  右侧留 14px 装订线，滚动条不压住文字  -->
            <ScrollViewer Padding="24,12,14,12"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="{x:Bind HasErrors, Converter={StaticResource BoolToVisibilityConverter}}">
                <ItemsControl ItemsSource="{x:Bind Errors}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:RecordRefreshErrorItem">
                            <Grid Padding="10,8,10,8"
                                  Background="{ThemeResource ControlFillColorDefaultBrush}"
                                  ColumnSpacing="10"
                                  CornerRadius="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="20"
                                        Height="20"
                                        Margin="0,2,0,0"
                                        VerticalAlignment="Top"
                                        CornerRadius="4">
                                    <Image Source="{x:Bind GameIcon}" Stretch="UniformToFill" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock FontSize="13"
                                               FontWeight="SemiBold"
                                               Text="{x:Bind Title}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Text="{x:Bind Account}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock FontSize="12"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               IsTextSelectionEnabled="True"
                                               Text="{x:Bind Detail}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!--  空态  -->
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12"
                        Visibility="{x:Bind HasNoErrors, Converter={StaticResource BoolToVisibilityConverter}}">
                <FontIcon HorizontalAlignment="Center"
                          FontSize="28"
                          Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                          Glyph="&#xE946;" />
                <TextBlock MaxWidth="320"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="{x:Bind lang:Lang.AutoRecordRefresh_NoErrors}"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Grid>


        <Grid Grid.Row="3" Padding="24,16,24,20" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button MinWidth="100"
                    HorizontalAlignment="Left"
                    Click="Button_ClearErrors_Click"
                    Content="{x:Bind lang:Lang.Common_Clear}"
                    IsEnabled="{x:Bind HasErrors}" />
            <Button Grid.Column="1"
                    MinWidth="100"
                    Click="Button_Close_Click"
                    Content="{x:Bind lang:Lang.Common_Cancel}"
                    Style="{ThemeResource AccentButtonStyle}" />
        </Grid>

    </Grid>

</ContentDialog>
