<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="Starward.Features.GameRecord.AutoRefresh.RecordRefreshConfigButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:cwc="using:CommunityToolkit.WinUI.Controls"
             xmlns:lang="using:Starward.Language"
             xmlns:local="using:Starward.Features.GameRecord.AutoRefresh"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sc="using:Starward.Controls"
             x:DefaultBindMode="OneWay"
             mc:Ignorable="d">

    <!--  与各数据页右侧面板顶部那排小图标按钮同款（分享等），放在这一排的最左边  -->
    <Button x:Name="Button_Root"
            MinWidth="0"
            MinHeight="0"
            Padding="8,4,8,4"
            VerticalAlignment="Center"
            sc:InstantTooltip.Placement="Top"
            sc:InstantTooltip.Text="{x:Bind lang:Lang.AutoRecordRefresh_Title}">
        <Grid Width="16" Height="16">
            <FontIcon HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      FontSize="14"
                      Glyph="&#xE787;" />
            <!--  只有这个账号的这个板块留下过异常记录时，才点这个红点（当月、上月任一有都算）  -->
            <Ellipse Width="6"
                     Height="6"
                     Margin="0,-2,-2,0"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Top"
                     Fill="{ThemeResource SystemFillColorCriticalBrush}"
                     Visibility="{x:Bind HasError, Converter={StaticResource BoolToVisibilityConverter}}" />
        </Grid>

        <Button.Flyout>
            <Flyout Opening="Flyout_Opening" Placement="LeftEdgeAlignedTop">
                <StackPanel Width="300" Spacing="12">

                    <!--  标题：板块名 + 这份配置属于哪个账号  -->
                    <StackPanel Spacing="2">
                        <TextBlock FontWeight="SemiBold" Text="{x:Bind ItemName}" />
                        <TextBlock FontSize="12"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   Text="{x:Bind RoleName}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!--  月报类板块先选月份（当月 / 上月），下面只显示一份配置；其余板块不出现这段  -->
                    <cwc:Segmented x:Name="Segmented_MonthTarget"
                                   AutomationProperties.Name="{x:Bind lang:Lang.AutoRecordRefresh_MonthTarget}"
                                   SelectedIndex="0"
                                   SelectionChanged="Segmented_MonthTarget_SelectionChanged"
                                   Visibility="{x:Bind IsMonthlyReportItem, Converter={StaticResource BoolToVisibilityConverter}}">
                        <cwc:SegmentedItem Content="{x:Bind lang:Lang.AutoRecordRefresh_MonthCurrent}" />
                        <cwc:SegmentedItem Content="{x:Bind lang:Lang.AutoRecordRefresh_MonthPrevious}" />
                    </cwc:Segmented>

                    <!--  单一任务配置块：月报类按上面选的月份读写对应配置，其余板块恒为当月  -->
                    <local:RecordRefreshJobPanel x:Name="JobPanel" ShowHint="True" />

                    <MenuFlyoutSeparator />

                    <!--  异常记录：后台不自愈，出了什么事只在那里看  -->
                    <Button HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Click="Button_ViewErrors_Click"
                            Style="{ThemeResource DateTimePickerFlyoutButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon FontSize="16" Glyph="&#xE7BA;" />
                            <TextBlock VerticalAlignment="Center" Text="{x:Bind lang:Lang.AutoRecordRefresh_Errors}" />
                        </StackPanel>
                    </Button>

                </StackPanel>
            </Flyout>
        </Button.Flyout>
    </Button>

</UserControl>
