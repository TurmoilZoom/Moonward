<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog x:Class="Starward.Features.GameRecord.GlobalPasswordLoginDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:lang="using:Starward.Language"
               xmlns:local="using:Starward.Features.GameRecord"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               Title="{x:Bind lang:Lang.HoyolabToolboxPage_PasswordLogin}"
               Background="{ThemeResource CustomAcrylicBrush}"
               BorderThickness="0"
               CornerRadius="8"
               Style="{ThemeResource DefaultContentDialogStyle}"
               mc:Ignorable="d">

    <!--  与验证码登录对话框一致：不用系统按钮区，按钮放在表单内  -->
    <ContentDialog.Resources>
        <Thickness x:Key="ContentDialogPadding">20</Thickness>
        <x:Double x:Key="ContentDialogMinWidth">360</x:Double>
        <StaticResource x:Key="ContentDialogSmokeFill" ResourceKey="ControlFillColorTransparentBrush" />
        <StaticResource x:Key="ContentDialogTopOverlay" ResourceKey="ControlFillColorTransparentBrush" />
    </ContentDialog.Resources>

    <StackPanel MinWidth="320" Spacing="10">
        <TextBox x:Name="TextBox_Account"
                 Header="{x:Bind lang:Lang.PasswordLogin_Account}"
                 InputScope="EmailNameOrAddress"
                 IsSpellCheckEnabled="False" />

        <PasswordBox x:Name="PasswordBox_Password"
                     Header="{x:Bind lang:Lang.PasswordLogin_Password}"
                     KeyDown="PasswordBox_Password_KeyDown" />

        <ProgressBar x:Name="ProgressBar_Loading"
                     IsIndeterminate="True"
                     Visibility="Collapsed" />

        <InfoBar x:Name="InfoBar_Feedback"
                 IsClosable="True"
                 IsOpen="False" />

        <Grid Margin="0,4,0,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="Button_Cancel"
                    Grid.Column="1"
                    MinWidth="88"
                    Click="Button_Cancel_Click"
                    Content="{x:Bind lang:Lang.Common_Cancel}" />
            <Button x:Name="Button_Login"
                    Grid.Column="2"
                    MinWidth="88"
                    Click="Button_Login_Click"
                    Content="{x:Bind lang:Lang.CaptchaLogin_Login}"
                    Style="{ThemeResource AccentButtonStyle}" />
        </Grid>
    </StackPanel>
</ContentDialog>
