<?xml version="1.0" encoding="utf-8" ?>
<sf:PageBase x:Class="Starward.Features.GameRecord.StarRail.TrailblazeCalendarPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:calendar="using:Starward.Core.GameRecord.StarRail.TrailblazeCalendar"
             xmlns:cc="using:CommunityToolkit.WinUI.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lang="using:Starward.Language"
             xmlns:local="using:Starward.Features.GameRecord.StarRail"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:wdd="using:Starward.Features.GameRecord.WeeklyDailyData"
             xmlns:sf="using:Starward.Frameworks"
             xmlns:sfg="using:Starward.Features.GameRecord"
             xmlns:sp="using:Starward.Pages"
             x:DefaultBindMode="OneWay"
             mc:Ignorable="d">

    <Page.Resources>
        <sfg:ColorToSolidColorBrushConverter x:Key="ColorToSolidColorBrushConverter" />
    </Page.Resources>

    <Grid>
        <!-- 星穹铁道开拓月历布局：左侧月份列表，右侧汇总卡片 + 每日收入图表 -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>



        <StackPanel Name="Image_Emoji"
                    Grid.RowSpan="2"
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="16"
                    Visibility="Collapsed">
            <Image Width="160"
                   Height="160"
                   Source="{StaticResource EmojiPom}" />
            <TextBlock HorizontalAlignment="Center"
                       FontSize="16"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="{x:Bind lang:Lang.HoyolabToolboxPage_NoData}" />
        </StackPanel>

        <StackPanel Margin="0,24,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Spacing="12">
            <Button Height="36"
                    BorderThickness="0"
                    CornerRadius="0,18,18,0"
                    IsEnabled="{x:Bind GetDataDetailsCommand.IsRunning, Converter={StaticResource BoolReversedConverter}}"
                    Style="{ThemeResource AccentButtonStyle}">
                <StackPanel Margin="4,0,4,0"
                            Orientation="Horizontal"
                            Spacing="8">
                    <Grid>
                        <ProgressRing Width="16"
                                      Height="16"
                                      IsActive="{x:Bind GetDataDetailsCommand.IsRunning}" />
                        <FontIcon FontSize="16"
                                  Glyph="&#xEA37;"
                                  Visibility="{x:Bind GetDataDetailsCommand.IsRunning, Converter={StaticResource BoolToVisibilityReversedConverter}}" />
                    </Grid>
                    <TextBlock Text="{x:Bind lang:Lang.TravelersDiaryPage_GetDetails}" />
                </StackPanel>
                <Button.Flyout>
                    <MenuFlyout x:Name="MenuFlyout_GetDetails" Placement="RightEdgeAlignedTop" />
                </Button.Flyout>
            </Button>
        </StackPanel>


        <ListView Name="ListView_MonthDataList"
                  Grid.Row="1"
                  Margin="0,12,0,0"
                  Padding="12,0,12,0"
                  ItemsSource="{x:Bind MonthDataList}"
                  SelectionChanged="ListView_MonthDataList_SelectionChanged"
                  SelectionMode="Single">
            <ListView.ItemContainerStyle>
                <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                    <Setter Property="Margin" Value="0,4,0,4" />
                    <Setter Property="Padding" Value="4,0,4,0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="calendar:TrailblazeCalendarMonthData">
                    <Grid Padding="12,8,12,8"
                          Background="{ThemeResource CustomOverlayAcrylicBrush}"
                          CornerRadius="4"
                          RowSpacing="2">
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock FontSize="16" Text="{x:Bind Month}" />
                        <Image Grid.Row="1"
                               Width="20"
                               Height="20"
                               HorizontalAlignment="Left"
                               Source="ms-appx:///Assets/Image/900001.png" />
                        <TextBlock Grid.Row="1"
                                   Margin="24,0,0,0"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="{x:Bind CurrentHcoin}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>




        <ScrollViewer Grid.RowSpan="2" Grid.Column="1">
            <StackPanel Margin="24" Spacing="8">

                <!--  Statistics Data  -->
                <Grid Margin="0,8,0,0"
                      Visibility="{x:Bind SelectMonthData, Converter={StaticResource ObjectToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock FontSize="16"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                        <Run Text="{x:Bind lang:Lang.TravelersDiaryPage_HistoricalData}" />
                        <Run Text="" />
                        <Run Text="{x:Bind SelectMonthData.Month}" />
                    </TextBlock>
                    <Button Grid.Column="1"
                            Padding="8,4,8,4"
                            VerticalAlignment="Center"
                            Command="{x:Bind GetDataDetailsCommand}"
                            CommandParameter="{x:Bind SelectMonthData.Month}"
                            IsEnabled="{x:Bind GetDataDetailsCommand.IsRunning, Converter={StaticResource BoolReversedConverter}}"
                            Visibility="{x:Bind IsRefreshButtonVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <ProgressRing Width="16"
                                          Height="16"
                                          IsActive="{x:Bind GetDataDetailsCommand.IsRunning}" />
                            <FontIcon FontSize="14"
                                      Glyph="&#xE72C;"
                                      Visibility="{x:Bind GetDataDetailsCommand.IsRunning, Converter={StaticResource BoolToVisibilityReversedConverter}}" />
                        </Grid>
                    </Button>
                </Grid>
                <Grid Padding="24,8,24,8"
                      Background="{ThemeResource CustomOverlayAcrylicBrush}"
                      CornerRadius="8"
                      Shadow="{ThemeResource ThemeShadow}"
                      Translation="0,0,16"
                      Visibility="{x:Bind SelectMonthData, Converter={StaticResource ObjectToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 收入统计：图标 + 名称 + 数字，居中（与 ZZZ 统一） -->
                    <StackPanel Grid.Row="0"
                                HorizontalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="48">
                        <StackPanel Spacing="4">
                            <Image Width="32"
                                   Height="32"
                                   Source="ms-appx:///Assets/Image/900001.png" />
                            <TextBlock HorizontalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind lang:Lang.TrailblazeCalendarPage_StellarJade}" />
                            <TextBlock HorizontalAlignment="Center"
                                       Text="{x:Bind SelectMonthData.CurrentHcoin}" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <Grid>
                                <Image Width="32"
                                       Height="32"
                                       Source="ms-appx:///Assets/Image/101.png" />
                                <Image Width="32"
                                       Height="32"
                                       RenderTransformOrigin="0.25,0.75"
                                       Source="ms-appx:///Assets/Image/102.png"
                                       Translation="1,-2,0"
                                       Visibility="Visible">
                                    <Image.RenderTransform>
                                        <RotateTransform Angle="30" />
                                    </Image.RenderTransform>
                                </Image>
                            </Grid>
                            <TextBlock HorizontalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind lang:Lang.TrailblazeCalendarPage_PassAndSpecialPass}" />
                            <TextBlock HorizontalAlignment="Center"
                                       Text="{x:Bind SelectMonthData.CurrentRailsPass}" />
                        </StackPanel>
                    </StackPanel>

                    <MenuFlyoutSeparator Grid.Row="1" Margin="0,8,0,8" />

                    <TextBlock Grid.Row="2"
                               Margin="0,0,0,0"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{x:Bind lang:Lang.TrailblazeCalendarPage_StellarJadeSources}" />
                    <!-- 每项横向条形图：名称+百分比+数字；ProgressBar 满宽，浅色轨道 -->
                    <ItemsControl Grid.Row="3"
                                  ItemsSource="{x:Bind SelectSeries}"
                                  Margin="0,4,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2,0,2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="4"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Legend}" />
                                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                <Run Text="{Binding Percent}" /><Run Text="%" />
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding Number}" />
                                    </Grid>
                                    <ProgressBar Grid.Row="1"
                                                 Margin="0,3,0,0"
                                                 Height="6"
                                                 HorizontalAlignment="Stretch"
                                                 Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                 Foreground="{Binding Color, Converter={StaticResource ColorToSolidColorBrushConverter}}"
                                                 Maximum="100"
                                                 Value="{Binding Percent}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <!--  Daily Data (周表格)  -->
                <TextBlock Margin="0,8,0,0"
                           FontSize="16"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Left"
                           Visibility="{x:Bind SelectMonthData, Converter={StaticResource ObjectToVisibilityConverter}}">
                    <Run Text="{x:Bind lang:Lang.HoyolabToolboxPage_DailyData}" />
                    <Run Text=" " />
                    <Run Text="{x:Bind WeekRangeText}" />
                </TextBlock>
                <Border Padding="24,8,24,8"
                        Background="{ThemeResource CustomOverlayAcrylicBrush}"
                        CornerRadius="8"
                        Shadow="{ThemeResource ThemeShadow}"
                        Translation="0,0,16"
                        Visibility="{x:Bind SelectMonthData, Converter={StaticResource ObjectToVisibilityConverter}}"
                        PointerPressed="DailyTable_PointerPressed"
                        PointerReleased="DailyTable_PointerReleased"
                        PointerCanceled="DailyTable_PointerCanceled">
                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <!-- 日期表头：拆分为两行，箭头放在日期圆圈所在行，与日期数字垂直居中对齐 -->
                        <!-- 左侧 100px 保持与资源标签列对齐，日期单元格从同一位置开始 -->
                        <Grid RowSpacing="4">
                            <!-- RowSpacing 让星期文字和下方日期圆圈之间有少量间距 -->
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- 星期文字行（仅文本） -->
                            <ItemsRepeater Grid.Column="1" Grid.Row="0" ItemsSource="{x:Bind WeekDateList}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Horizontal" Spacing="2" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="wdd:WeekDateCell">
                                        <StackPanel Width="72" HorizontalAlignment="Center">
                                            <TextBlock Text="{x:Bind WeekdayText}"
                                                       FontSize="11"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>

                            <!-- 左箭头：放在圆圈行，与日期数字对齐；不可切换时隐藏但占位，避免表头列宽塌陷 -->
                            <Button Grid.Column="0" Grid.Row="1"
                                    Padding="6,2,6,2"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Command="{x:Bind PreviousWeekCommand}"
                                    Opacity="{x:Bind wdd:WeeklyDailyDataHelper.GetArrowOpacity(CanGoPreviousWeek)}"
                                    IsHitTestVisible="{x:Bind CanGoPreviousWeek}">
                                <FontIcon Glyph="&#xE76B;" FontSize="12" />
                            </Button>

                            <!-- 日期圆圈行（数字 + 圆形） -->
                            <ItemsRepeater Grid.Column="1" Grid.Row="1" ItemsSource="{x:Bind WeekDateList}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Horizontal" Spacing="2" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="wdd:WeekDateCell">
                                        <StackPanel Width="72" HorizontalAlignment="Center">
                                            <Grid Width="24"
                                                  Height="24">
                                                <Ellipse Width="24"
                                                         Height="24"
                                                         Fill="{x:Bind wdd:WeeklyDailyDataHelper.GetDateCellBackground(State)}"
                                                         Stroke="{x:Bind wdd:WeeklyDailyDataHelper.GetDateCellBorderBrush(State)}"
                                                         StrokeThickness="{x:Bind wdd:WeeklyDailyDataHelper.GetDateCellStrokeThickness(State)}" />
                                                <TextBlock Text="{x:Bind DayText}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontSize="12"
                                                           Foreground="{x:Bind wdd:WeeklyDailyDataHelper.GetDateCellForeground(State)}" />
                                            </Grid>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>

                            <!-- 右箭头：放在圆圈行，与日期数字对齐；不可切换时隐藏但占位，避免表头列宽塌陷 -->
                            <Button Grid.Column="2" Grid.Row="1"
                                    Padding="6,2,6,2"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Command="{x:Bind NextWeekCommand}"
                                    Opacity="{x:Bind wdd:WeeklyDailyDataHelper.GetArrowOpacity(CanGoNextWeek)}"
                                    IsHitTestVisible="{x:Bind CanGoNextWeek}">
                                <FontIcon Glyph="&#xE76C;" FontSize="12" />
                            </Button>
                        </Grid>

                        <!-- 资源行：每行左侧名称+图标，右侧 7 个数据单元格（内容宽度，不拉伸） -->
                        <ItemsRepeater ItemsSource="{x:Bind WeeklyResourceRows}">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="wdd:WeeklyResourceRow">
                                    <Grid ColumnSpacing="2" Margin="0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <!-- 资源名称 -->
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="4"
                                                    VerticalAlignment="Center">
                                            <Image Width="16"
                                                   Height="16"
                                                   Source="{x:Bind Icon}" />
                                            <TextBlock Text="{x:Bind Name}"
                                                       VerticalAlignment="Center"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <!-- 7 个数据单元格 -->
                                        <ItemsRepeater Grid.Column="1" ItemsSource="{x:Bind Cells}">
                                            <ItemsRepeater.Layout>
                                                <StackLayout Orientation="Horizontal" Spacing="2" />
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="wdd:WeeklyResourceCell">
                                                    <Border Width="72"
                                                            Height="30"
                                                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                            CornerRadius="3">
                                                        <TextBlock Text="{x:Bind DisplayText}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="14" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>


            </StackPanel>
        </ScrollViewer>


    </Grid>
</sf:PageBase>
