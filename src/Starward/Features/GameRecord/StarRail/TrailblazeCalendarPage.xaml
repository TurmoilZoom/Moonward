<?xml version="1.0" encoding="utf-8" ?>
<sf:PageBase x:Class="Starward.Features.GameRecord.StarRail.TrailblazeCalendarPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:calendar="using:Starward.Core.GameRecord.StarRail.TrailblazeCalendar"
             xmlns:cc="using:CommunityToolkit.WinUI.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lang="using:Starward.Language"
             xmlns:local="using:Starward.Features.GameRecord.StarRail"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sc="using:Starward.Controls"
             xmlns:sf="using:Starward.Frameworks"
             xmlns:sfg="using:Starward.Features.GameRecord"
             xmlns:sp="using:Starward.Pages"
             x:DefaultBindMode="OneWay"
             mc:Ignorable="d">

    <Page.Resources>
        <sfg:ColorToSolidColorBrushConverter x:Key="ColorToSolidColorBrushConverter" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>



        <StackPanel Name="Image_Emoji"
                    Grid.RowSpan="2"
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="16"
                    Visibility="Collapsed">
            <Image Width="160"
                   Height="160"
                   Source="{StaticResource EmojiPom}" />
            <TextBlock HorizontalAlignment="Center"
                       FontSize="16"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="{x:Bind lang:Lang.HoyolabToolboxPage_NoData}" />
        </StackPanel>

        <StackPanel Margin="0,24,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Spacing="12">
            <Button Height="36"
                    BorderThickness="0"
                    CornerRadius="0,18,18,0"
                    IsEnabled="{x:Bind GetDataDetailsCommand.IsRunning, Converter={StaticResource BoolReversedConverter}}"
                    Style="{ThemeResource AccentButtonStyle}">
                <StackPanel Margin="4,0,4,0"
                            Orientation="Horizontal"
                            Spacing="8">
                    <Grid>
                        <ProgressRing Width="16"
                                      Height="16"
                                      IsActive="{x:Bind GetDataDetailsCommand.IsRunning}" />
                        <FontIcon FontSize="16"
                                  Glyph="&#xEA37;"
                                  Visibility="{x:Bind GetDataDetailsCommand.IsRunning, Converter={StaticResource BoolToVisibilityReversedConverter}}" />
                    </Grid>
                    <TextBlock Text="{x:Bind lang:Lang.TravelersDiaryPage_GetDetails}" />
                </StackPanel>
                <Button.Flyout>
                    <MenuFlyout x:Name="MenuFlyout_GetDetails" Placement="RightEdgeAlignedTop" />
                </Button.Flyout>
            </Button>
        </StackPanel>


        <ListView Name="ListView_MonthDataList"
                  Grid.Row="1"
                  Margin="0,12,0,0"
                  Padding="12,0,12,0"
                  ItemsSource="{x:Bind MonthDataList}"
                  SelectionChanged="ListView_MonthDataList_SelectionChanged"
                  SelectionMode="Single">
            <ListView.ItemContainerStyle>
                <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                    <Setter Property="Margin" Value="0,4,0,4" />
                    <Setter Property="Padding" Value="4,0,4,0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="calendar:TrailblazeCalendarSummaryMonth">
                    <Grid Padding="12,8,12,8"
                          Background="{ThemeResource CustomOverlayAcrylicBrush}"
                          CornerRadius="4"
                          RowSpacing="2">
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock FontSize="16" Text="{x:Bind DataMonth}" />
                        <Image Grid.Row="1"
                               Width="20"
                               Height="20"
                               HorizontalAlignment="Left"
                               Source="ms-appx:///Assets/Image/900001.png" />
                        <TextBlock Grid.Row="1"
                                   Margin="24,0,0,0"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="{x:Bind CurrentHcoin}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>




        <ScrollViewer Grid.RowSpan="2" Grid.Column="1">
            <StackPanel Margin="24" Spacing="8">

                <Grid Visibility="{x:Bind SelectMonthData, Converter={StaticResource ObjectToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock FontSize="16"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                        <Run Text="{x:Bind lang:Lang.InterKnotMonthlyReportPage_StatisticalData}" />
                        <Run Text="" />
                        <Run Text="{x:Bind SelectMonthData.Month}" />
                    </TextBlock>
                    <Button Grid.Column="1"
                            Padding="6"
                            VerticalAlignment="Center"
                            BorderThickness="0"
                            Command="{x:Bind RefreshMonthDataCommand}"
                            CornerRadius="4"
                            IsEnabled="{x:Bind RefreshMonthDataCommand.IsRunning, Converter={StaticResource BoolReversedConverter}}"
                            Style="{ThemeResource DateTimePickerFlyoutButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind lang:Lang.Common_Refresh}"
                            Visibility="{x:Bind SelectMonthHasDetail, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <ProgressRing Width="14"
                                          Height="14"
                                          IsActive="{x:Bind RefreshMonthDataCommand.IsRunning}" />
                            <FontIcon FontSize="14"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      Glyph="&#xE72C;"
                                      Visibility="{x:Bind RefreshMonthDataCommand.IsRunning, Converter={StaticResource BoolToVisibilityReversedConverter}}" />
                        </Grid>
                    </Button>
                </Grid>
                <Grid Padding="24,8,24,8"
                      Background="{ThemeResource CustomOverlayAcrylicBrush}"
                      CornerRadius="8"
                      Shadow="{ThemeResource ThemeShadow}"
                      Translation="0,0,16"
                      Visibility="{x:Bind SelectMonthData, Converter={StaticResource ObjectToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ItemsControl ItemsSource="{x:Bind SelectMonthAwards}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="24" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Spacing="4">
                                    <Grid Width="32" Height="32">
                                        <Image Width="32"
                                               Height="32"
                                               Source="{Binding Image}"
                                               Visibility="{Binding IsCompositePass, Converter={StaticResource BoolToVisibilityReversedConverter}}" />
                                        <Grid Visibility="{Binding IsCompositePass, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Image Width="32" Source="ms-appx:///Assets/Image/101.png" />
                                            <Image Width="32"
                                                   RenderTransformOrigin="0.25,0.75"
                                                   Source="ms-appx:///Assets/Image/102.png"
                                                   Translation="1,-2,0">
                                                <Image.RenderTransform>
                                                    <RotateTransform Angle="30" />
                                                </Image.RenderTransform>
                                            </Image>
                                        </Grid>
                                    </Grid>
                                    <TextBlock HorizontalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               HorizontalTextAlignment="Center"
                                               Text="{Binding Name}" />
                                    <TextBlock HorizontalAlignment="Center"
                                               HorizontalTextAlignment="Center"
                                               Text="{Binding Count}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <MenuFlyoutSeparator Grid.Row="1" Margin="0,8,0,8" />

                    <TextBlock Grid.Row="2"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{x:Bind lang:Lang.TrailblazeCalendarPage_StellarJadeSources}" />
                    <sc:ColorRectChart Grid.Row="3"
                                       Grid.ColumnSpan="3"
                                       Height="20"
                                       Margin="0,8,0,0"
                                       HorizontalAlignment="Stretch"
                                       CornerRadius="4"
                                       Series="{x:Bind SelectSeries}" />
                    <ItemsControl Grid.Row="4"
                                  Grid.ColumnSpan="3"
                                  Margin="0,8,-4,0"
                                  ItemsSource="{x:Bind SelectSeries}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <cc:WrapPanel HorizontalSpacing="12"
                                              Orientation="Horizontal"
                                              VerticalSpacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Border Width="16"
                                            Height="16"
                                            Background="{Binding Color, Converter={StaticResource ColorToSolidColorBrushConverter}}"
                                            CornerRadius="4" />
                                    <TextBlock VerticalAlignment="Center" Text="{Binding Legend}" />
                                    <TextBlock VerticalAlignment="Center">
                                        <Run Text="{Binding Percent}" /><Run Text="%" />
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <TextBlock Margin="0,8,0,0"
                           FontSize="16"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Visibility="{x:Bind SelectMonthData, Converter={StaticResource ObjectToVisibilityConverter}}">
                    <Run Text="{x:Bind lang:Lang.HoyolabToolboxPage_DailyData}" />
                    <Run Text="" />
                    <Run Text="{x:Bind SelectMonthData.Month}" />
                </TextBlock>
                <Border Padding="12,8,12,8"
                        Background="{ThemeResource CustomOverlayAcrylicBrush}"
                        CornerRadius="8"
                        Shadow="{ThemeResource ThemeShadow}"
                        Translation="0,0,16"
                        Visibility="{x:Bind SelectMonthData, Converter={StaticResource ObjectToVisibilityConverter}}">
                    <ItemsRepeater ItemsSource="{x:Bind DayDataList}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Text="{Binding Day}" />
                                    <Image Grid.Column="1"
                                           Width="24"
                                           Height="24"
                                           Source="ms-appx:///Assets/Image/900001.png" />
                                    <TextBlock Grid.Column="2"
                                               VerticalAlignment="Center"
                                               Text="{Binding Jade}" />
                                    <ProgressBar Grid.Column="3"
                                                 MinHeight="20"
                                                 HorizontalAlignment="Stretch"
                                                 Background="Transparent"
                                                 Foreground="#A066BCF2"
                                                 Maximum="1"
                                                 Value="{Binding JadeProgress}" />
                                    <Grid Grid.Column="4"
                                          Width="24"
                                          Height="24">
                                        <Image Width="24" Source="ms-appx:///Assets/Image/101.png" />
                                        <Image Width="24"
                                               RenderTransformOrigin="0.25,0.75"
                                               Source="ms-appx:///Assets/Image/102.png"
                                               Translation="1,-2,0"
                                               Visibility="Visible">
                                            <Image.RenderTransform>
                                                <RotateTransform Angle="30" />
                                            </Image.RenderTransform>
                                        </Image>
                                    </Grid>
                                    <TextBlock Grid.Column="5"
                                               VerticalAlignment="Center"
                                               Text="{Binding Pass}" />
                                    <ProgressBar Grid.Column="6"
                                                 MinHeight="20"
                                                 HorizontalAlignment="Stretch"
                                                 Background="Transparent"
                                                 Foreground="#A0F2DE77"
                                                 Maximum="1"
                                                 Value="{Binding PassProgress}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </Border>


            </StackPanel>
        </ScrollViewer>


    </Grid>
</sf:PageBase>