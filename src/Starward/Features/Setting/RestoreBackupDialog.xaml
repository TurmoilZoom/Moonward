<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog x:Class="Starward.Features.Setting.RestoreBackupDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:lang="using:Starward.Language"
               xmlns:local="using:Starward.Features.Setting"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               xmlns:sh="using:Starward.Helpers"
               x:DefaultBindMode="OneWay"
               Background="{ThemeResource CustomAcrylicBrush}"
               BorderThickness="0"
               Closed="ContentDialog_Closed"
               Loaded="ContentDialog_Loaded"
               Style="{ThemeResource DefaultContentDialogStyle}"
               mc:Ignorable="d">

    <StackPanel Width="440" Spacing="12">
        <TextBlock FontSize="20"
                   Text="{x:Bind lang:Lang.RestoreBackupDialog_Title}"
                   TextWrapping="Wrap" />
        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="{x:Bind lang:Lang.RestoreBackupDialog_Description}"
                   TextWrapping="Wrap" />

        <!--  备份位置里的备份；也可以选别处的文件  -->
        <Grid Margin="0,4,0,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="{x:Bind lang:Lang.RestoreBackupDialog_Backups}" />
            <HyperlinkButton Grid.Column="1"
                             Padding="8,4"
                             Command="{x:Bind BrowseCommand}"
                             Content="{x:Bind lang:Lang.RestoreBackupDialog_Browse}"
                             IsEnabled="{x:Bind CanOperate}" />
        </Grid>
        <ListView MaxHeight="216"
                  IsEnabled="{x:Bind CanOperate}"
                  ItemsSource="{x:Bind Backups}"
                  SelectedItem="{x:Bind SelectedBackup, Mode=TwoWay}"
                  SelectionMode="Single"
                  Visibility="{x:Bind sh:BindConverter.BoolToVisibility(HasBackups)}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:RestoreBackupItem">
                    <StackPanel Padding="0,8" Spacing="2">
                        <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                        <TextBlock FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="{x:Bind Description}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <TextBlock FontSize="12"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="{x:Bind lang:Lang.RestoreBackupDialog_NoBackup}"
                   TextWrapping="Wrap"
                   Visibility="{x:Bind sh:BindConverter.BoolToVisibility(ShowNoBackupHint)}" />

        <!--  选中备份的检查结果  -->
        <StackPanel Spacing="2" Visibility="{x:Bind sh:BindConverter.ObjectToVisibility(PreparedInfoText)}">
            <TextBlock FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="{x:Bind PreparedInfoText}"
                       TextWrapping="Wrap" />
            <TextBlock FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="{x:Bind lang:Lang.RestoreBackupDialog_LegacyNote}"
                       TextWrapping="Wrap"
                       Visibility="{x:Bind sh:BindConverter.BoolToVisibility(PreparedIsLegacy)}" />
        </StackPanel>

        <!--  还原方式  -->
        <RadioButtons Header="{x:Bind lang:Lang.RestoreBackupDialog_Mode}"
                      IsEnabled="{x:Bind CanOperate}"
                      SelectedIndex="{x:Bind ModeIndex, Mode=TwoWay}">
            <RadioButton>
                <TextBlock Text="{x:Bind lang:Lang.RestoreBackupDialog_ModeOverwrite}" TextWrapping="Wrap" />
            </RadioButton>
            <RadioButton>
                <TextBlock Text="{x:Bind lang:Lang.RestoreBackupDialog_ModeMerge}" TextWrapping="Wrap" />
            </RadioButton>
        </RadioButtons>

        <!--  进度与结果  -->
        <StackPanel Orientation="Horizontal"
                    Spacing="8"
                    Visibility="{x:Bind sh:BindConverter.BoolToVisibility(IsBusy)}">
            <ProgressRing Width="16"
                          Height="16"
                          IsActive="{x:Bind IsBusy}" />
            <TextBlock VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="{x:Bind ProgressText}"
                       TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <TextBlock Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                   Text="{x:Bind ResultText}"
                   TextWrapping="Wrap"
                   Visibility="{x:Bind sh:BindConverter.ObjectToVisibility(ResultText)}" />
        <TextBlock Foreground="{ThemeResource SystemFillColorCautionBrush}"
                   Text="{x:Bind ErrorText}"
                   TextWrapping="Wrap"
                   Visibility="{x:Bind sh:BindConverter.ObjectToVisibility(ErrorText)}" />

        <StackPanel Margin="0,8,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="12">
            <Button MinWidth="100"
                    Command="{x:Bind RestoreCommand}"
                    Content="{x:Bind RestoreButtonText}"
                    IsEnabled="{x:Bind CanRestore}"
                    Style="{ThemeResource AccentButtonStyle}" />
            <Button MinWidth="100"
                    Click="Button_Close_Click"
                    Content="{x:Bind lang:Lang.Common_Close}" />
        </StackPanel>
    </StackPanel>

</ContentDialog>
