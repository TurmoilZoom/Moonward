<?xml version="1.0" encoding="utf-8" ?>
<sf:PageBase x:Class="Starward.Features.Setting.GeneralSetting"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lang="using:Starward.Language"
             xmlns:local="using:Starward.Features.Setting"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sf="using:Starward.Frameworks"
             xmlns:sfv="using:Starward.Features.ViewHost"
             x:DefaultBindMode="OneWay"
             mc:Ignorable="d">

    <ScrollViewer x:Name="ScrollViewer_General">
        <StackPanel x:Name="StackPanel_General" Padding="0,0,24,0">


            <!--  语言  -->
            <TextBlock FontSize="20" Text="{x:Bind lang:Lang.SettingPage_Language}" />
            <ComboBox Name="ComboBox_Language"
                      Height="36"
                      MinWidth="260"
                      Margin="0,12,0,0"
                      Padding="18.5,0,0,0"
                      BorderThickness="0"
                      CornerRadius="8,18,18,8"
                      SelectionChanged="ComboBox_Language_SelectionChanged" />


            <!--  游戏启动后  -->
            <TextBlock Margin="0,20,0,0"
                       FontSize="20"
                       Text="{x:Bind lang:Lang.ExperienceSettingPage_AfterStartingGame}" />
            <ComboBox Name="ComboBox_StartGameAction"
                      Height="36"
                      MinWidth="260"
                      Margin="0,12,0,0"
                      Padding="18.5,0,0,0"
                      BorderThickness="0"
                      CornerRadius="8,18,18,8"
                      SelectedIndex="{x:Bind StartGameAction, Mode=TwoWay}">
                <ComboBoxItem Content="{x:Bind lang:Lang.ExperienceSettingPage_DoNothing}" />
                <ComboBoxItem Content="{x:Bind lang:Lang.ExperienceSettingPage_MinimizeToTaskbar}" />
                <ComboBoxItem Content="{x:Bind lang:Lang.ExperienceSettingPage_MinimizeToSystemTray}" />
            </ComboBox>


            <!--  关闭窗口选项  -->
            <TextBlock Margin="0,20,0,0"
                       FontSize="20"
                       Text="{x:Bind lang:Lang.ExperienceSettingPage_CloseWindowOption}" />
            <StackPanel Margin="0,12,0,0"
                        Orientation="Horizontal"
                        Spacing="24">
                <RadioButton Name="RadioButton_CloseWindowOption_Hide"
                             Checked="RadioButton_CloseWindowOption_Checked"
                             Content="{x:Bind lang:Lang.ExperienceSettingPage_MinimizeToSystemTray}"
                             GroupName="CloseWindowOption"
                             Tag="{x:Bind sfv:MainWindowCloseOption.Hide}" />
                <RadioButton Name="RadioButton_CloseWindowOption_Exit"
                             Checked="RadioButton_CloseWindowOption_Checked"
                             Content="{x:Bind lang:Lang.ExperienceSettingPage_ExitCompletely}"
                             GroupName="CloseWindowOption"
                             Tag="{x:Bind sfv:MainWindowCloseOption.Exit}" />
            </StackPanel>


            <!--  开机启动：标题 / 说明 / 开关为一组。
                 从签到提示深链跳入时压暗其它项、左侧色条标出这一块（软聚光，不是闪框也不是 TeachingTip）。  -->
            <Grid x:Name="Grid_StartAtLogin" Margin="0,20,0,0">
                <Border x:Name="Border_StartAtLoginAccent"
                        Width="3"
                        Margin="-12,-4,0,-4"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Stretch"
                        CornerRadius="2"
                        IsHitTestVisible="False">
                    <Border.Background>
                        <SolidColorBrush Color="{ThemeResource SystemAccentColor}" />
                    </Border.Background>
                </Border>
                <StackPanel>
                    <TextBlock x:Name="TextBlock_StartAtLogin"
                               FontSize="20"
                               Text="{x:Bind lang:Lang.SettingPage_StartAtLogin}" />
                    <TextBlock Margin="0,8,0,0"
                               FontSize="14"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{x:Bind lang:Lang.SettingPage_StartAtLoginDesc}"
                               TextWrapping="Wrap" />
                    <ToggleSwitch x:Name="ToggleSwitch_StartAtLogin"
                                  Margin="0,8,0,0"
                                  IsEnabled="{x:Bind StartAtLoginAvailable}"
                                  IsOn="{x:Bind StartAtLogin, Mode=TwoWay}"
                                  OffContent="{x:Bind lang:Lang.SettingPage_StartAtLoginSwitch}"
                                  OnContent="{x:Bind lang:Lang.SettingPage_StartAtLoginSwitch}" />
                    <TextBlock Margin="0,8,0,0"
                               FontSize="14"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{x:Bind lang:Lang.SettingPage_StartAtLoginRemovableHint}"
                               TextWrapping="Wrap"
                               Visibility="{x:Bind StartAtLoginUnavailableVisibility}" />
                    <TextBlock Margin="0,8,0,0" HorizontalAlignment="Left">
                        <Hyperlink Click="Hyperlink_StartupApps_Click"
                                   NavigateUri="ms-settings:startupapps"
                                   UnderlineStyle="None">
                            <Run Text="{x:Bind lang:Lang.SettingPage_StartAtLoginWindowsSettings}" />
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Grid>


            <MenuFlyoutSeparator Margin="0,20,0,0" />

            <!--  透明/动画效果  -->
            <TextBlock Margin="0,20,0,0"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="{x:Bind lang:Lang.SettingPage_ForABetterExperiencePleaseEnableTheFollowingFeaturesInSystemSettings}"
                       TextWrapping="Wrap" />
            <TextBlock Margin="0,12,0,0" HorizontalAlignment="Left">
                <Hyperlink Click="Hyperlink_VisualEffects_Click"
                           NavigateUri="ms-settings:easeofaccess-visualeffects"
                           UnderlineStyle="None">
                    <Run Text="{x:Bind lang:Lang.AppearanceSettingPage_TransparencyEffects}" />
                </Hyperlink>
                <Run Text="" />
                <Run Text="" />
                <Hyperlink Click="Hyperlink_VisualEffects_Click"
                           NavigateUri="ms-settings:easeofaccess-visualeffects"
                           UnderlineStyle="None">
                    <Run Text="{x:Bind lang:Lang.AppearanceSettingPage_AnimationEffects}" />
                </Hyperlink>
            </TextBlock>

        </StackPanel>
    </ScrollViewer>

</sf:PageBase>
