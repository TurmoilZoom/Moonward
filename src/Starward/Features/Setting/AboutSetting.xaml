<?xml version="1.0" encoding="utf-8" ?>
<sf:PageBase x:Class="Starward.Features.Setting.AboutSetting"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:animatedvisuals="using:Starward.AnimatedVisuals"
             xmlns:lang="using:Starward.Language"
             xmlns:local="using:Starward.Features.Setting"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:h="using:Starward.Helpers"
             xmlns:s="using:Starward"
             xmlns:sf="using:Starward.Frameworks"
             x:DefaultBindMode="OneWay"
             mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ScrollViewer Grid.Column="0">
            <StackPanel Padding="0,0,24,0">

                <TextBlock FontSize="24"
                           FontWeight="Bold"
                           Text="Moonward" />

                <!--  当前版本  -->
                <StackPanel Margin="0,12,0,0"
                            Orientation="Horizontal"
                            Spacing="4">
                    <TextBlock Text="{x:Bind lang:Lang.SettingPage_CurrentVersion}" />
                    <TextBlock FontWeight="SemiBold"
                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                               Text="{x:Bind s:AppConfig.AppVersion}" />
                </StackPanel>

                <!--  预览版 / 推送更新 / 静默更新：静默是推送的子选项  -->
                <StackPanel Margin="0,16,0,0">
                    <ToggleSwitch IsOn="{x:Bind EnablePreviewRelease, Mode=TwoWay}"
                                  OffContent="{x:Bind lang:Lang.SettingPage_JoinPreviewReleaseChannel}"
                                  OnContent="{x:Bind lang:Lang.SettingPage_JoinPreviewReleaseChannel}" />
                    <ToggleSwitch Margin="0,-4,0,0"
                                  IsOn="{x:Bind EnableUpdateNotification, Mode=TwoWay}"
                                  OffContent="{x:Bind lang:Lang.AboutSetting_PushUpdate}"
                                  OnContent="{x:Bind lang:Lang.AboutSetting_PushUpdate}" />
                    <StackPanel Visibility="{x:Bind h:BindConverter.BoolToVisibility(EnableUpdateNotification)}">
                        <ToggleSwitch Margin="0,-4,0,0"
                                      IsOn="{x:Bind EnableSilentUpdate, Mode=TwoWay}"
                                      OffContent="{x:Bind lang:Lang.AboutSetting_SilentUpdate}"
                                      OnContent="{x:Bind lang:Lang.AboutSetting_SilentUpdate}" />
                        <TextBlock Margin="0,4,0,0"
                                   FontSize="14"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="{x:Bind lang:Lang.AboutSetting_SilentUpdateDesc}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>

                <Grid Margin="0,12,0,0" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!--  检查更新  -->
                    <Button Height="40"
                            Padding="12,0,16,0"
                            BorderThickness="0"
                            Command="{x:Bind CheckUpdateCommand}"
                            CornerRadius="4,20,20,4"
                            Style="{ThemeResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE752;" />
                            <TextBlock Text="{x:Bind lang:Lang.SettingPage_CheckForUpdate}" />
                        </StackPanel>
                    </Button>
                    <!--  已是最新版本  -->
                    <TextBlock Grid.Column="1"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Visibility="{x:Bind LatestVersion, Converter={StaticResource ObjectToVisibilityConverter}}">
                        <Run Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind lang:Lang.AboutSetting_UpdatedToTheLatestVersion}" />
                        <Run Text="" />
                        <Run Foreground="{ThemeResource SystemFillColorSuccessBrush}" Text="{x:Bind LatestVersion}" />
                    </TextBlock>
                    <ProgressRing Grid.Column="1"
                                  Width="20"
                                  Height="20"
                                  HorizontalAlignment="Left"
                                  IsIndeterminate="{x:Bind CheckUpdateCommand.IsRunning}"
                                  Visibility="{x:Bind CheckUpdateCommand.IsRunning}" />
                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{x:Bind UpdateErrorText}"
                               TextWrapping="Wrap" />
                </Grid>

                <!--  相关链接  -->
                <TextBlock Margin="0,24,0,0"
                           FontSize="20"
                           Text="{x:Bind lang:Lang.AboutSettingPage_Links}" />
                <TextBlock Margin="0,12,0,0" HorizontalAlignment="Left">
                    <Hyperlink NavigateUri="https://github.com/TurmoilZoom/Moonward" UnderlineStyle="None">
                        <Run FontWeight="Bold"
                             Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                             Text="{x:Bind lang:Lang.SettingPage_ProjectHomepage}" />
                    </Hyperlink>
                </TextBlock>
                <TextBlock Margin="0,8,0,0" HorizontalAlignment="Left">
                    <Hyperlink Click="Hyperlink_ReportIssue_Click" UnderlineStyle="None">
                        <Run FontWeight="Bold"
                             Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                             Text="{x:Bind lang:Lang.SettingPage_ReportIssue}" />
                    </Hyperlink>
                </TextBlock>
                <TextBlock Margin="0,8,0,0" HorizontalAlignment="Left">
                    <Hyperlink NavigateUri="https://github.com/TurmoilZoom/Moonward/releases" UnderlineStyle="None">
                        <Run FontWeight="Bold"
                             Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                             Text="{x:Bind lang:Lang.SettingPage_ReleaseHistroy}" />
                    </Hyperlink>
                </TextBlock>
                <TextBlock Margin="0,8,0,0" HorizontalAlignment="Left">
                    <Hyperlink NavigateUri="https://github.com/TurmoilZoom/Moonward/blob/rebase/develop/docs/Privacy.md" UnderlineStyle="None">
                        <Run FontWeight="Bold"
                             Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                             Text="{x:Bind lang:Lang.SettingPage_PrivacyPolicy}" />
                    </Hyperlink>
                </TextBlock>
                <TextBlock Margin="0,8,0,0" HorizontalAlignment="Left">
                    <Hyperlink NavigateUri="https://github.com/sponsors/TurmoilZoom" UnderlineStyle="None">
                        <Run FontWeight="Bold"
                             Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                             Text="{x:Bind lang:Lang.SettingPage_Donate}" />
                    </Hyperlink>
                </TextBlock>

            </StackPanel>
        </ScrollViewer>

        <!--  Logo：LottieGen 生成的 C# 动画源（源 JSON：static/cat_playing_animation.json），固定在页面右下角，跨两列以保持在整页右下角。
              悬浮播放的命中层是外层透明 Border（只覆盖猫本体这一块），播放器本身 IsHitTestVisible=False，
              这样只有鼠标移到猫身上才触发（而非整页），命中区也限制在右下角空白处、尽量不挡左侧链接与滚动。  -->
        <Border x:Name="Border_CatHover"
                Grid.ColumnSpan="2"
                Margin="0,0,0,12"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Background="Transparent"
                PointerEntered="Lottie_AboutLogo_PointerEntered"
                PointerExited="Lottie_AboutLogo_PointerExited">
            <AnimatedVisualPlayer x:Name="Lottie_AboutLogo"
                                  Width="376"
                                  Height="160"
                                  AutoPlay="False"
                                  IsHitTestVisible="False"
                                  Stretch="Uniform">
                <animatedvisuals:Cat_playing_animation />
            </AnimatedVisualPlayer>
        </Border>

        <!--  致谢卡片：功能 / 设计参考的开源项目，固定在页面右侧顶部。项目名为专有名词故用字面量，不进 resx；仅标题与说明本地化。声明在 Lottie 之后以确保重叠时卡片在上层  -->
        <Border Grid.Column="1"
                Width="280"
                Padding="16,12,16,14"
                VerticalAlignment="Top"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <StackPanel>
                <TextBlock FontSize="16"
                           FontWeight="SemiBold"
                           Text="{x:Bind lang:Lang.AboutSettingPage_Acknowledgements}" />
                <TextBlock Margin="0,6,0,0"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="{x:Bind lang:Lang.AboutSettingPage_AcknowledgementsDesc}"
                           TextWrapping="Wrap" />
                <TextBlock Margin="0,12,0,0" HorizontalAlignment="Left">
                    <Hyperlink NavigateUri="https://github.com/Scighost/Starward" UnderlineStyle="None">
                        <Run FontWeight="Bold"
                             Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                             Text="Starward" />
                    </Hyperlink>
                </TextBlock>
                <TextBlock Margin="0,8,0,0" HorizontalAlignment="Left">
                    <Hyperlink NavigateUri="https://github.com/CollapseLauncher/Collapse" UnderlineStyle="None">
                        <Run FontWeight="Bold"
                             Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                             Text="Collapse" />
                    </Hyperlink>
                </TextBlock>
                <TextBlock Margin="0,8,0,0" HorizontalAlignment="Left">
                    <Hyperlink NavigateUri="https://github.com/character-map-uwp/Character-Map-UWP" UnderlineStyle="None">
                        <Run FontWeight="Bold"
                             Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                             Text="Character-Map-UWP" />
                    </Hyperlink>
                </TextBlock>
                <TextBlock Margin="0,8,0,0" HorizontalAlignment="Left">
                    <Hyperlink NavigateUri="https://github.com/DGP-Studio/Snap.Hutao" UnderlineStyle="None">
                        <Run FontWeight="Bold"
                             Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                             Text="Snap.Hutao" />
                    </Hyperlink>
                </TextBlock>
                <TextBlock Margin="0,8,0,0" HorizontalAlignment="Left">
                    <Hyperlink NavigateUri="https://github.com/BTMuli/TeyvatGuide" UnderlineStyle="None">
                        <Run FontWeight="Bold"
                             Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                             Text="TeyvatGuide" />
                    </Hyperlink>
                </TextBlock>
                <TextBlock Margin="0,8,0,0" HorizontalAlignment="Left">
                    <Hyperlink NavigateUri="https://github.com/Womsxd/MihoyoBBSTools" UnderlineStyle="None">
                        <Run FontWeight="Bold"
                             Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                             Text="MihoyoBBSTools" />
                    </Hyperlink>
                </TextBlock>
                <TextBlock Margin="0,8,0,0" HorizontalAlignment="Left">
                    <Hyperlink NavigateUri="https://github.com/UIGF-org/mihoyo-api-collect" UnderlineStyle="None">
                        <Run FontWeight="Bold"
                             Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                             Text="UIGF · mihoyo-api-collect" />
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>

</sf:PageBase>
