<?xml version="1.0" encoding="utf-8" ?>
<sf:WindowEx x:Class="Starward.Features.ViewHost.WelcomeWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cwc="using:CommunityToolkit.WinUI.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lang="using:Starward.Language"
             xmlns:local="using:Starward.Features.ViewHost"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sf="using:Starward.Frameworks"
             xmlns:sh="using:Starward.Helpers"
             Title="Moonward"
             x:DefaultBindMode="OneWay"
             mc:Ignorable="d">


    <Grid Loaded="Grid_Loaded">
        <Grid.Resources>
            <!--  已有数据来源的说明：可见的一段与三段占位共用排版；占位只参与测量，不显示、不可命中、不进无障碍树  -->
            <Style x:Key="DataSourceDescriptionStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="IsTextScaleFactorEnabled" Value="False" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="DataSourceDescriptionSizerStyle"
                   BasedOn="{StaticResource DataSourceDescriptionStyle}"
                   TargetType="TextBlock">
                <Setter Property="Opacity" Value="0" />
                <Setter Property="IsHitTestVisible" Value="False" />
                <Setter Property="AutomationProperties.AccessibilityView" Value="Raw" />
            </Style>
        </Grid.Resources>

        <Image HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Source="ms-appx:///Assets/Image/UI_CutScene_1130320101A.png"
               Stretch="UniformToFill" />
        <Rectangle HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch"
                   Fill="{ThemeResource ControlOnImageFillColorDefaultBrush}" />



        <StackPanel Margin="48,0,48,0" VerticalAlignment="Center">
            <!--  欢迎  -->
            <TextBlock FontSize="24"
                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                       IsTextScaleFactorEnabled="False"
                       Text="{x:Bind lang:Lang.WelcomeView_DearPlayerWelcomeToStarward}" />
            <TextBlock Margin="0,20,0,0"
                       FontSize="16"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       IsTextScaleFactorEnabled="False"
                       Text="{x:Bind lang:Lang.WelcomeView_WelcomeToStarwardDescription}"
                       TextWrapping="Wrap" />

            <!--  以下各功能区之间统一隔 28，区内标题到内容统一隔 12；区内不留常驻空行，间距只由这些边距决定  -->

            <!--  数据文件夹  -->
            <TextBlock Margin="0,28,0,0"
                       FontSize="16"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       IsTextScaleFactorEnabled="False"
                       Text="{x:Bind lang:Lang.WelcomeView_SelectUserDataFolderDescription}"
                       TextWrapping="Wrap" />
            <Grid Margin="0,12,0,0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button VerticalAlignment="Center"
                        BorderThickness="0"
                        Command="{x:Bind ChangeUserDataFolderCommand}"
                        Content="{x:Bind lang:Lang.SelectDirectoryPage_SelectFolder}"
                        IsEnabled="{x:Bind CanChangeUserDataFolder}"
                        IsTextScaleFactorEnabled="False"
                        Style="{ThemeResource AccentButtonStyle}" />
                <!--  提示（未选择、需要管理员权限等）紧跟在路径后面，与按钮同一行，不另起一行占位  -->
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           FontSize="12"
                           IsTextScaleFactorEnabled="False"
                           TextTrimming="CharacterEllipsis"
                           ToolTipService.ToolTip="{x:Bind UserDataFolderErrorMessage}">
                    <Run Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind UserDataFolder}" /><Run Text="{x:Bind PathMessageSeparator(UserDataFolder, UserDataFolderErrorMessage)}" /><Run Foreground="{ThemeResource SystemFillColorCautionBrush}" Text="{x:Bind UserDataFolderErrorMessage}" />
                </TextBlock>
            </Grid>

            <!--  导入已有数据（三选一，默认不导入）：与月报自动更新里「当月 / 上月」同款 Segmented  -->
            <TextBlock Margin="0,28,0,0"
                       FontSize="16"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       IsTextScaleFactorEnabled="False"
                       Text="{x:Bind lang:Lang.WelcomeView_ImportExistingData}" />
            <!--  选「从 Starward 导入」时，选择目录的按钮和解析到的位置跟在切换按钮右边；行高至少 32（与该按钮同高），切换时不变  -->
            <Grid Margin="0,12,0,0"
                  MinHeight="32"
                  ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <cwc:Segmented x:Name="Segmented_DataSource"
                               VerticalAlignment="Center"
                               AutomationProperties.Name="{x:Bind lang:Lang.WelcomeView_ImportExistingData}"
                               IsEnabled="{x:Bind CanOperate}"
                               SelectedIndex="0"
                               SelectionChanged="Segmented_DataSource_SelectionChanged">
                    <!--
                        选中项整块填充与「选择文件夹」按钮（AccentButtonStyle，本页无边框）相同的强调色，不要底部的高亮条：
                        控件模板里「选中 / 选中悬停 / 选中按下」都读下面这几个键，高亮条只读 Pill 系列，改成透明即不显示。只在本页生效；高对比度用系统高亮色
                    -->
                    <cwc:Segmented.Resources>
                        <ResourceDictionary>
                            <ResourceDictionary.ThemeDictionaries>
                                <ResourceDictionary x:Key="Light">
                                    <StaticResource x:Key="SegmentedItemBackgroundSelected" ResourceKey="AccentFillColorDefaultBrush" />
                                    <StaticResource x:Key="SegmentedItemBorderBrushSelected" ResourceKey="AccentFillColorDefaultBrush" />
                                    <StaticResource x:Key="SegmentedItemForegroundSelected" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
                                    <StaticResource x:Key="SegmentedPillBackground" ResourceKey="ControlFillColorTransparentBrush" />
                                    <StaticResource x:Key="SegmentedPillBackgroundPointerOver" ResourceKey="ControlFillColorTransparentBrush" />
                                    <StaticResource x:Key="SegmentedPillBackgroundPressed" ResourceKey="ControlFillColorTransparentBrush" />
                                    <StaticResource x:Key="SegmentedPillBackgroundDisabled" ResourceKey="ControlFillColorTransparentBrush" />
                                </ResourceDictionary>
                                <ResourceDictionary x:Key="Dark">
                                    <StaticResource x:Key="SegmentedItemBackgroundSelected" ResourceKey="AccentFillColorDefaultBrush" />
                                    <StaticResource x:Key="SegmentedItemBorderBrushSelected" ResourceKey="AccentFillColorDefaultBrush" />
                                    <StaticResource x:Key="SegmentedItemForegroundSelected" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
                                    <StaticResource x:Key="SegmentedPillBackground" ResourceKey="ControlFillColorTransparentBrush" />
                                    <StaticResource x:Key="SegmentedPillBackgroundPointerOver" ResourceKey="ControlFillColorTransparentBrush" />
                                    <StaticResource x:Key="SegmentedPillBackgroundPressed" ResourceKey="ControlFillColorTransparentBrush" />
                                    <StaticResource x:Key="SegmentedPillBackgroundDisabled" ResourceKey="ControlFillColorTransparentBrush" />
                                </ResourceDictionary>
                                <ResourceDictionary x:Key="HighContrast">
                                    <StaticResource x:Key="SegmentedItemBackgroundSelected" ResourceKey="SystemColorHighlightColorBrush" />
                                    <StaticResource x:Key="SegmentedItemBorderBrushSelected" ResourceKey="SystemColorHighlightColorBrush" />
                                    <StaticResource x:Key="SegmentedItemForegroundSelected" ResourceKey="SystemColorHighlightTextColorBrush" />
                                    <StaticResource x:Key="SegmentedPillBackground" ResourceKey="ControlFillColorTransparentBrush" />
                                    <StaticResource x:Key="SegmentedPillBackgroundPointerOver" ResourceKey="ControlFillColorTransparentBrush" />
                                    <StaticResource x:Key="SegmentedPillBackgroundPressed" ResourceKey="ControlFillColorTransparentBrush" />
                                    <StaticResource x:Key="SegmentedPillBackgroundDisabled" ResourceKey="ControlFillColorTransparentBrush" />
                                </ResourceDictionary>
                            </ResourceDictionary.ThemeDictionaries>
                        </ResourceDictionary>
                    </cwc:Segmented.Resources>
                    <cwc:SegmentedItem Content="{x:Bind lang:Lang.WelcomeView_DoNotImport}" IsTextScaleFactorEnabled="False" />
                    <cwc:SegmentedItem Content="{x:Bind lang:Lang.WelcomeView_MigrateFromStarward}" IsTextScaleFactorEnabled="False" />
                    <cwc:SegmentedItem Content="{x:Bind lang:Lang.WelcomeView_SyncFromLanDevice}" IsTextScaleFactorEnabled="False" />
                </cwc:Segmented>
                <Grid Grid.Column="1"
                      ColumnSpacing="12"
                      Visibility="{x:Bind sh:BindConverter.BoolToVisibility(IsStarwardSourceSelected)}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Height="32"
                            VerticalAlignment="Center"
                            BorderThickness="0"
                            Command="{x:Bind SelectStarwardFolderCommand}"
                            Content="{x:Bind lang:Lang.WelcomeView_SelectStarwardFolder}"
                            IsEnabled="{x:Bind CanPickStarwardFolder}"
                            IsTextScaleFactorEnabled="False"
                            Style="{ThemeResource AccentButtonStyle}" />
                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   IsTextScaleFactorEnabled="False"
                                   Text="{x:Bind StarwardSourcePath}"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{x:Bind sh:BindConverter.ObjectToVisibility(StarwardSourcePath)}" />
                        <TextBlock FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   IsTextScaleFactorEnabled="False"
                                   Text="{x:Bind lang:Lang.WelcomeView_StarwardDataNotFound}"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{x:Bind sh:BindConverter.BoolToVisibility(ShowStarwardNotFoundHint)}" />
                    </Grid>
                </Grid>
            </Grid>
            <!--  当前选项的说明，选 Starward 目录出错时换成报错（切到其他选项会清空）。高度恒为三段说明里最长的一段，切换选项时整页不跳（本页垂直居中）  -->
            <Grid Margin="0,8,0,0">
                <!--  占位：三段说明都参与测量，窗口变窄换行时也按最长一段撑开  -->
                <TextBlock Style="{StaticResource DataSourceDescriptionSizerStyle}" Text="{x:Bind ImportLaterHint}" />
                <TextBlock Style="{StaticResource DataSourceDescriptionSizerStyle}" Text="{x:Bind lang:Lang.WelcomeView_MigrateFromStarwardDescription}" />
                <TextBlock Style="{StaticResource DataSourceDescriptionSizerStyle}" Text="{x:Bind LanSyncDescription}" />
                <TextBlock Style="{StaticResource DataSourceDescriptionStyle}"
                           Text="{x:Bind DataSourceDescription}"
                           Visibility="{x:Bind sh:BindConverter.ObjectToVisibilityReversed(StarwardFolderErrorMessage)}" />
                <TextBlock Foreground="{ThemeResource SystemFillColorCautionBrush}"
                           Style="{StaticResource DataSourceDescriptionStyle}"
                           Text="{x:Bind StarwardFolderErrorMessage}"
                           Visibility="{x:Bind sh:BindConverter.ObjectToVisibility(StarwardFolderErrorMessage)}" />
            </Grid>

            <!--  旧版本数据迁移提示  -->
            <TextBlock Margin="0,12,0,0"
                       FontSize="13"
                       Foreground="{ThemeResource SystemFillColorCautionBrush}"
                       IsTextScaleFactorEnabled="False"
                       Text="{x:Bind MigrationNoticeText}"
                       TextWrapping="Wrap"
                       Visibility="{x:Bind sh:BindConverter.BoolToVisibility(HasLegacyData)}" />

            <!--  迁移进度  -->
            <StackPanel Margin="0,12,0,0"
                        Spacing="6"
                        Visibility="{x:Bind sh:BindConverter.BoolToVisibility(IsMigrating)}">
                <ProgressBar IsIndeterminate="{x:Bind MigrationIsIndeterminate}"
                             Maximum="100"
                             Value="{x:Bind MigrationProgressValue}" />
                <TextBlock FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           IsTextScaleFactorEnabled="False"
                           Text="{x:Bind MigrationStatus}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <!--  必要的检查  -->
            <TextBlock Margin="0,28,0,0"
                       FontSize="16"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       IsTextScaleFactorEnabled="False"
                       Text="{x:Bind lang:Lang.WelcomeView_BeforeStartingSomeNecessaryEnvironmentChecksAreRequired}" />


            <!--  WebView2  -->
            <StackPanel Height="32"
                        Margin="0,8,0,0"
                        Orientation="Horizontal"
                        Spacing="12">
                <FontIcon Margin="0,0,-4,0"
                          FontSize="16"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          Glyph="&#xE774;"
                          IsTextScaleFactorEnabled="False" />
                <TextBlock VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           IsTextScaleFactorEnabled="False"
                           Text="WebView2 Runtime" />
                <TextBlock VerticalAlignment="Center"
                           Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                           IsTextScaleFactorEnabled="False"
                           Text="{x:Bind WebView2Version}"
                           Visibility="{x:Bind sh:BindConverter.ObjectToVisibility(WebView2Version)}" />
                <TextBlock VerticalAlignment="Center"
                           Foreground="{ThemeResource SystemFillColorCautionBrush}"
                           IsTextScaleFactorEnabled="False"
                           Text="{x:Bind lang:Lang.WelcomeView_NotInstalled}"
                           Visibility="{x:Bind sh:BindConverter.ObjectToVisibilityReversed(WebView2Version)}" />
                <HyperlinkButton Padding="8,4,8,4"
                                 VerticalAlignment="Center"
                                 Content="{x:Bind lang:Lang.WelcomeView_InstallNow}"
                                 Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                 IsTextScaleFactorEnabled="False"
                                 NavigateUri="https://developer.microsoft.com/microsoft-edge/webview2"
                                 Visibility="{x:Bind sh:BindConverter.ObjectToVisibilityReversed(WebView2Version)}" />
            </StackPanel>

            <!--  WebP  -->
            <StackPanel Height="32"
                        Margin="0,8,0,0"
                        Orientation="Horizontal"
                        Spacing="12">
                <FontIcon Margin="0,0,-4,0"
                          FontSize="16"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          Glyph="&#xE91B;"
                          IsTextScaleFactorEnabled="False" />
                <TextBlock VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           IsTextScaleFactorEnabled="False"
                           Text="WebP Decoder" />
                <TextBlock VerticalAlignment="Center"
                           Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                           IsTextScaleFactorEnabled="False"
                           Text="{x:Bind lang:Lang.WelcomeView_Installed}"
                           Visibility="{x:Bind WebpDecoderSupport}" />
                <TextBlock VerticalAlignment="Center"
                           Foreground="{ThemeResource SystemFillColorCautionBrush}"
                           IsTextScaleFactorEnabled="False"
                           Text="{x:Bind lang:Lang.WelcomeView_NotInstalled}"
                           Visibility="{x:Bind sh:BindConverter.BoolToVisibilityReversed(WebpDecoderSupport)}" />
                <HyperlinkButton Padding="8,4,8,4"
                                 VerticalAlignment="Center"
                                 Content="{x:Bind lang:Lang.WelcomeView_InstallNow}"
                                 Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                 IsTextScaleFactorEnabled="False"
                                 NavigateUri="https://apps.microsoft.com/detail/9pg2dk419drg"
                                 Visibility="{x:Bind sh:BindConverter.BoolToVisibilityReversed(WebpDecoderSupport)}" />
            </StackPanel>

            <!--  透明/动画效果  -->
            <TextBlock Margin="0,28,0,0"
                       HorizontalAlignment="Left"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="{x:Bind lang:Lang.SettingPage_ForABetterExperiencePleaseEnableTheFollowingFeaturesInSystemSettings}"
                       TextWrapping="Wrap" />
            <TextBlock Margin="0,12,0,0" HorizontalAlignment="Left">
                <Hyperlink Click="Hyperlink_Click"
                           NavigateUri="ms-settings:easeofaccess-visualeffects"
                           UnderlineStyle="None">
                    <Run Text="{x:Bind lang:Lang.AppearanceSettingPage_TransparencyEffects}" />
                </Hyperlink>
                <Run Text="" />
                <Run Text="" />
                <Hyperlink Click="Hyperlink_Click"
                           NavigateUri="ms-settings:easeofaccess-visualeffects"
                           UnderlineStyle="None">
                    <Run Text="{x:Bind lang:Lang.AppearanceSettingPage_AnimationEffects}" />
                </Hyperlink>
            </TextBlock>

            <!--  智能应用控制提醒  -->
            <TextBlock Margin="0,28,0,0"
                       HorizontalAlignment="Left"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="{x:Bind lang:Lang.WelcomeView_IfStarwardTakesALongTimeToStartItIsRecommendedToDisableSmartAppControlInWindowsSecurity}"
                       TextWrapping="Wrap"
                       Visibility="{x:Bind IsWin11}" />
            <TextBlock Margin="0,12,0,0"
                       HorizontalAlignment="Left"
                       Visibility="{x:Bind IsWin11}">
                <Hyperlink Click="Hyperlink_Click"
                           NavigateUri="windowsdefender://smartapp"
                           UnderlineStyle="None">
                    <Run Text="{x:Bind lang:Lang.WelcomeView_OpenWindowsSecurity}" />
                </Hyperlink>
                <Run Text="" />
                <Run Text="" />
                <Hyperlink Click="Hyperlink_Click"
                           NavigateUri="https://github.com/Scighost/Starward/issues/1388"
                           UnderlineStyle="None">
                    <Run Text="{x:Bind lang:Lang.WelcomeView_LearnMore}" />
                </Hyperlink>
            </TextBlock>


        </StackPanel>


        <!--  Moonward 启动：文案固定，不随导入选项、旧数据迁移变化  -->
        <Button Height="40"
                Margin="0,0,80,48"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                BorderThickness="0"
                Command="{x:Bind StartCommand}"
                CornerRadius="8,20,20,8"
                IsEnabled="{x:Bind CanStartStarward}"
                Style="{ThemeResource AccentButtonStyle}">
            <TextBlock Margin="4,0,8,0"
                       FontSize="14"
                       IsTextScaleFactorEnabled="False"
                       Text="{x:Bind lang:Lang.WelcomeView_StarwardStart}" />
        </Button>


    </Grid>


</sf:WindowEx>
