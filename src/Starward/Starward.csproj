<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
		<TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
		<LangVersion>preview</LangVersion>
		<RootNamespace>Starward</RootNamespace>
		<!-- 产品品牌为 Moonward；命名空间/项目名仍为 Starward 以便变基上游 -->
		<AssemblyName>Moonward</AssemblyName>
		<Product>Moonward</Product>
		<AssemblyTitle>Moonward</AssemblyTitle>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<Platforms>x86;x64;ARM64</Platforms>
		<RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
		<!-- 本地 F5 / dotnet build -p:Platform=x64 也按 RID 输出可双击的自包含 exe；命令行已指定 -r 时不覆盖 -->
		<RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' And '$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
		<RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' And '$(Platform)' == 'x86'">win-x86</RuntimeIdentifier>
		<RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' And ('$(Platform)' == 'ARM64' Or '$(Platform)' == 'arm64')">win-arm64</RuntimeIdentifier>
		<PublishProfile>win-$(Platform).pubxml</PublishProfile>
		<UseWinUI>true</UseWinUI>
		<EnableMsixTooling>true</EnableMsixTooling>
		<WindowsPackageType>None</WindowsPackageType>
		<WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
		<DefineConstants>DISABLE_XAML_GENERATED_MAIN</DefineConstants>
		<BuiltInComInteropSupport>true</BuiltInComInteropSupport>
		<ApplicationIcon>../logo.ico</ApplicationIcon>
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
		<JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
		<CsWinRTAotOptimizerEnabled Condition="'$(Configuration)' == 'Debug'">false</CsWinRTAotOptimizerEnabled>
		<CsWinRTAotOptimizerEnabled Condition="'$(Configuration)' != 'Debug'">true</CsWinRTAotOptimizerEnabled>
		<CETCompat>false</CETCompat>
		<!-- 仅当显式指定 PackLocalSetup=true 时，生成结束后才打 Velopack Setup.exe。默认 false，F5 不受影响。
		     VS：编辑本项目的 Starward.csproj.user，把 PackLocalSetup 改为 true，再点「生成」。
		     命令行：dotnet build src/Starward/Starward.csproj -c Release -p:Platform=x64 -p:PackLocalSetup=true -->
		<PackLocalSetup Condition="'$(PackLocalSetup)' == ''">false</PackLocalSetup>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="CommunityToolkit.WinUI.Animations" Version="8.2.251219" />
		<PackageReference Include="CommunityToolkit.WinUI.Behaviors" Version="8.2.251219" />
		<PackageReference Include="CommunityToolkit.WinUI.Controls.Primitives" Version="8.2.251219" />
		<!--  DO NOT Update Segmented https://github.com/CommunityToolkit/Windows/pull/699  -->
		<PackageReference Include="CommunityToolkit.WinUI.Controls.Segmented" Version="8.2.250402" />
		<PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
		<PackageReference Include="CommunityToolkit.WinUI.Helpers" Version="8.2.251219" />
		<PackageReference Include="ComputeSharp.D2D1.WinUI" Version="3.2.0" />
		<PackageReference Include="Dapper" Version="2.1.79" />
		<PackageReference Include="H.InputSimulator" Version="1.5.0" />
		<PackageReference Include="H.NotifyIcon.WinUI" Version="2.4.1" />
		<PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
		<PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.10" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.10" />
		<PackageReference Include="Microsoft.Extensions.Configuration.CommandLine" Version="10.0.10" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Ini" Version="10.0.10" />
		<PackageReference Include="Microsoft.Graphics.Win2D" Version="1.3.2" ExcludeAssets="all" />
		<PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.2.0" />
		<PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260710003" />
		<PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.8249" />
		<PackageReference Include="MiniExcel" Version="1.45.0" />
		<PackageReference Include="NuGet.Versioning" Version="7.6.0" />
		<PackageReference Include="Octokit" Version="14.0.0" />
		<PackageReference Include="Scighost.WinUI" Version="0.1.0" />
		<PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
		<PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
		<PackageReference Include="Starward.Assets" Version="0.6.3" />
		<PackageReference Include="Starward.Codec" Version="0.5.2" />
		<PackageReference Include="Starward.GameInput" Version="0.3.1" />
		<PackageReference Include="Starward.NativeLib" Version="0.3.1" />
		<PackageReference Include="Starward.Win2D" Version="1.3.2-release.1" />
		<PackageReference Include="Velopack" Version="1.2.0" />
		<PackageReference Include="System.IO.Hashing" Version="10.0.10" />
		<PackageReference Include="Vanara.PInvoke.DwmApi" Version="5.0.5" />
		<PackageReference Include="Vanara.PInvoke.Ole" Version="5.0.5" />
		<PackageReference Include="Vanara.PInvoke.SetupAPI" Version="5.0.5" />
		<PackageReference Include="Vanara.PInvoke.Shell32" Version="5.0.5" />
		<Manifest Include="$(ApplicationManifest)" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Starward.Core\Starward.Core.csproj" />
		<ProjectReference Include="..\Starward.Language\Starward.Language.csproj" />
		<ProjectReference Include="..\Starward.RPC\Starward.RPC.csproj" />
		<ProjectReference Include="..\Starward.Setup.Core\Starward.Setup.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Content Update="Assets\**">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<!--  签到图标、本地 Logo、游戏快捷方式 .ico 等，输出到 static\  -->
		<Content Include="static\**">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<Target Name="RemoveDlls" AfterTargets="Publish">
		<Delete Files="$(PublishDir)DirectML.dll" />
		<Delete Files="$(PublishDir)onnxruntime.dll" />
	</Target>

	<Target Name="PackLocalSetupCore">
		<PropertyGroup>
			<_SetupScript>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\build-setup.ps1'))</_SetupScript>
			<_SetupArch Condition="'$(Platform)' == 'ARM64' Or '$(Platform)' == 'arm64'">arm64</_SetupArch>
			<_SetupArch Condition="'$(_SetupArch)' == ''">x64</_SetupArch>
		</PropertyGroup>
		<Message Importance="high" Text="PackLocalSetup: packing Velopack Setup.exe ($(_SetupArch))" />
		<Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(_SetupScript)&quot; -Architecture $(_SetupArch)"
		      WorkingDirectory="$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..'))"
		      ConsoleToMSBuild="true" />
	</Target>

	<!-- 显式目标：dotnet build -t:PackLocalSetup -->
	<Target Name="PackLocalSetup" DependsOnTargets="PackLocalSetupCore" />

	<!-- VS / 命令行指定 -p:PackLocalSetup=true 时，在生成成功后打包。不指定则跳过。 -->
	<Target Name="PackLocalSetupAfterBuild"
	        AfterTargets="Build"
	        Condition="'$(DesignTimeBuild)' != 'true' And '$(PackLocalSetup)' == 'true'"
	        DependsOnTargets="PackLocalSetupCore" />

</Project>
